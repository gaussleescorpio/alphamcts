      "output": "price_range"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["price_range", "close"],
      "output": "range_pct_close"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["relative_volume", "range_pct_close"],
      "output": "participation_ratio"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "low"],
      "output": "close_position"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_position", "price_range"],
      "output": "close_location"
    },
    {
      "name": "Mul",
      "param": [],
