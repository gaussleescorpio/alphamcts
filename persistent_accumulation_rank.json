{
  "formula": [
    {
      "name": "Ma",
      "param": ["volume_baseline_window"],
      "input": ["volume"],
      "output": "volume_baseline"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["volume", "volume_baseline"],
      "output": "relative_volume"
    },
    {
      "name": "Sub",
      "param": [],
