{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "open"],
      "output": "daily_body"
    },
    {
      "name": "Abs",
      "param": [],
      "input": ["daily_body"],
      "output": "abs_body"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["high", "low"],
      "output": "daily_range"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["abs_body", "daily_range"],
      "output": "body_range_ratio"
    },
    {
      "name": "Ma",
      "param": ["smoothing_window"],
      "input": ["body_range_ratio"],
      "output": "smoothed_conviction"
    },
    {
      "name": "Zscore",
      "param": ["lookback_period"],
      "input": ["smoothed_conviction"],
      "output": "conviction_zscore"
    },
    {
      "name": "Zscore",
      "param": ["lookback_period"],
      "input": ["volume"],
      "output": "volume_zscore"
    },
    {
      "name": "Greater",
      "param": ["volume_threshold"],
      "input": ["volume_zscore", "volume_threshold"],
      "output": "elevated_volume_flag"
    },
    {
      "name": "Sum",
      "param": ["persistence_window"],
      "input": ["elevated_volume_flag"],
      "output": "persistence_count"
    },
    {
      "name": "Greater",
      "param": ["min_persist_count"],
      "input": ["persistence_count", "min_persist_count"],
      "output": "volume_persistence_gate"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["volume_zscore", "volume_persistence_gate"],
      "output": "gated_volume_zscore"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["conviction_zscore", "gated_volume_zscore"],
      "output": "conviction_volume_signal"
    },
    {
      "name": "Vari",
      "param": ["range_vol_window"],
      "input": ["daily_range"],
      "output": "short_range_volatility"
    },
    {
      "name": "Vari",
      "param": ["slow_range_vol_window"],
      "input": ["daily_range"],
      "output": "long_range_volatility"
    },
    {
      "name": "Greater",
      "param": [],
      "input": ["short_range_volatility", "long_range_volatility"],
      "output": "short_vol_dominates"
    },
    {
      "name": "Greater",
      "param": [],
      "input": ["long_range_volatility", "short_range_volatility"],
      "output": "long_vol_dominates"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["short_range_volatility", "short_vol_dominates"],
      "output": "selected_short_volatility"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["long_range_volatility", "long_vol_dominates"],
      "output": "selected_long_volatility"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["selected_short_volatility", "selected_long_volatility"],
      "output": "stabilized_range_volatility"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["conviction_volume_signal", "stabilized_range_volatility"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "smoothing_window": 5,
      "lookback_period": 20,
      "volume_threshold": 1.0,
      "persistence_window": 10,
      "min_persist_count": 5,
      "range_vol_window": 10,
      "slow_range_vol_window": 60
    },
    {
      "smoothing_window": 10,
      "lookback_period": 40,
      "volume_threshold": 0.75,
      "persistence_window": 20,
      "min_persist_count": 8,
      "range_vol_window": 20,
      "slow_range_vol_window": 80
    },
    {
      "smoothing_window": 20,
      "lookback_period": 60,
      "volume_threshold": 1.5,
      "persistence_window": 30,
      "min_persist_count": 10,
      "range_vol_window": 30,
      "slow_range_vol_window": 120
    }
  ]
}
