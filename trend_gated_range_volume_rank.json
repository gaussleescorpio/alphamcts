{
  "formula": [
    {"name": "Min", "param": ["lookback_window"], "input": ["low"], "output": "price_low"},
    {"name": "Max", "param": ["lookback_window"], "input": ["high"], "output": "price_high"},
    {"name": "Sub", "param": [], "input": ["price_high", "price_low"], "output": "range_span"},
    {"name": "Sub", "param": [], "input": ["close", "price_low"], "output": "close_minus_low"},
    {"name": "Div", "param": [], "input": ["close_minus_low", "range_span"], "output": "range_position"},
    {"name": "Diff", "param": ["daily_change_lag"], "input": ["close"], "output": "close_change"},
    {"name": "Diff", "param": ["daily_change_lag"], "input": ["volume"], "output": "volume_change"},
    {"name": "Corr", "param": ["confirmation_window"], "input": ["close_change", "volume_change"], "output": "volume_confirmation"},
    {"name": "Rank", "param": ["lookback_window"], "input": ["range_position"], "output": "range_rank"},
    {"name": "Rank", "param": ["lookback_window"], "input": ["volume_confirmation"], "output": "volume_rank"},
    {"name": "Add", "param": [], "input": ["range_rank", "volume_rank"], "output": "rank_composite"},
    {"name": "Diff", "param": ["confirmation_window"], "input": ["close"], "output": "price_momentum"},
    {"name": "Sign", "param": [], "input": ["price_momentum"], "output": "trend_direction"},
    {"name": "Mul", "param": [], "input": ["rank_composite", "trend_direction"], "output": "gated_signal"},
    {"name": "Rank", "param": ["lookback_window"], "input": ["gated_signal"], "output": "alpha"}
  ],
  "arguments": [
    {"lookback_window": 20, "confirmation_window": 10, "daily_change_lag": 1},
    {"lookback_window": 60, "confirmation_window": 20, "daily_change_lag": 1},
    {"lookback_window": 10, "confirmation_window": 5, "daily_change_lag": 1}
  ]
}
