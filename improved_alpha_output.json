{
  "name": "clv_rank_composite_signal",
  "description": "Ranks stocks by a blended score of where the close sits in the daily range (short vs long horizon), how persistently that strength holds as a smooth ratio rather than a hard on/off rule, and whether quiet-range and open-to-close alignment support the same story. One final rank on the sum keeps top names from winning on a single spike leg alone.",
  "pseudo_code": [
    "range_hl = Sub(input=[high, low], param=[])",
    "clv = Div(input=[Sub(input=[close, low], param=[]), range_hl], param=[])",
    "clv_short = Ma(input=[clv], param=[clv_short_window])",
    "clv_long = Ma(input=[clv], param=[clv_long_window])",
    "clv_rank_short = Rank(input=[clv_short], param=[rank_window])",
    "clv_rank_long = Rank(input=[clv_long], param=[rank_window])",
    "clv_rank_spread = Sub(input=[clv_rank_short, clv_rank_long], param=[])",
    "leg_clv_smoothed = Ma(input=[clv_rank_spread], param=[clv_short_window])",
    "clv_persistence_ratio = Div(input=[clv_short, clv_long], param=[])",
    "leg_persistence = Rank(input=[Ma(input=[clv_persistence_ratio], param=[clv_short_window])], param=[rank_window])",
    "range_pct = Div(input=[range_hl, close], param=[])",
    "range_ma_long = Ma(input=[range_pct], param=[rank_window])",
    "range_ma_short = Ma(input=[range_pct], param=[clv_short_window])",
    "range_rank_long = Rank(input=[range_ma_long], param=[rank_window])",
    "range_rank_short = Rank(input=[range_ma_short], param=[rank_window])",
    "range_rank_spread = Sub(input=[range_rank_long, range_rank_short], param=[])",
    "leg_range = Rank(input=[Tanh(input=[range_rank_spread], param=[])], param=[rank_window])",
    "intraday_position = Div(input=[Sub(input=[close, open], param=[]), range_hl], param=[])",
    "intraday_ma = Ma(input=[intraday_position], param=[clv_short_window])",
    "clv_ma_for_corr = Ma(input=[clv], param=[clv_short_window])",
    "rank_clv_for_corr = Rank(input=[clv_ma_for_corr], param=[rank_window])",
    "rank_intraday = Rank(input=[intraday_ma], param=[rank_window])",
    "corr_clv_intraday = Corr(input=[rank_clv_for_corr, rank_intraday], param=[rank_window])",
    "leg_corr = Rank(input=[corr_clv_intraday], param=[rank_window])",
    "leg_regime = Add(input=[leg_range, leg_corr], param=[])",
    "rank_clv_leg = Rank(input=[leg_clv_smoothed], param=[rank_window])",
    "rank_sum = Add(input=[Add(input=[rank_clv_leg, leg_persistence], param=[]), leg_regime], param=[])",
    "alpha = Rank(input=[rank_sum], param=[rank_window])"
  ]
}
