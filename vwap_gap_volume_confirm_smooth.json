{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "price_vwap_gap"
    },
    {
      "name": "Zscore",
      "param": ["zscore_window"],
      "input": ["price_vwap_gap"],
      "output": "fair_value_z"
    },
    {
      "name": "Tanh",
      "param": [],
      "input": ["fair_value_z"],
      "output": "capped_fair_z"
    },
    {
      "name": "Rank",
      "param": ["rank_window"],
      "input": ["capped_fair_z"],
      "output": "fair_value_rank"
    },
    {
      "name": "Sign",
      "param": [],
      "input": ["price_vwap_gap"],
      "output": "gap_sign"
    },
    {
      "name": "Med",
      "param": ["zscore_window"],
      "input": ["volume"],
      "output": "volume_median"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["volume", "volume_median"],
      "output": "volume_centered"
    },
    {
      "name": "Sign",
      "param": [],
      "input": ["volume_centered"],
      "output": "volume_sign"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["gap_sign", "volume_sign"],
      "output": "sign_product"
    },
    {
      "name": "Neg",
      "param": [],
      "input": ["sign_product"],
      "output": "sign_product_neg"
    },
    {
      "name": "Greater",
      "param": [],
      "input": ["sign_product", "sign_product_neg"],
      "output": "volume_confirms_gap"
    },
    {
      "name": "Ma",
      "param": ["rank_window"],
      "input": ["volume_confirms_gap"],
      "output": "alignment_fraction"
    },
    {
      "name": "Rank",
      "param": ["rank_window"],
      "input": ["alignment_fraction"],
      "output": "alignment_rank"
    },
    {
      "name": "Mul",
      "param": ["alignment_weight"],
      "input": ["alignment_rank"],
      "output": "weighted_alignment"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["fair_value_rank", "weighted_alignment"],
      "output": "raw_composite"
    },
    {
      "name": "Ma",
      "param": ["smoothing_window"],
      "input": ["raw_composite"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "zscore_window": 20,
      "rank_window": 60,
      "smoothing_window": 5,
      "alignment_weight": 0.5
    },
    {
      "zscore_window": 10,
      "rank_window": 40,
      "smoothing_window": 3,
      "alignment_weight": 1.0
    },
    {
      "zscore_window": 15,
      "rank_window": 80,
      "smoothing_window": 8,
      "alignment_weight": 0.75
    }
  ]
}
