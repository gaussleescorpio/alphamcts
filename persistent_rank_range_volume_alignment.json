      "output": "normalized_intraday_range"
    },
    {
      "name": "Rank",
      "param": ["correlation_window"],
      "input": ["normalized_intraday_range"],
      "output": "rank_stable_range"
    },
    {
      "name": "Rank",
      "param": ["correlation_window"],
      "input": ["volume"],
      "output": "rank_stable_volume"
    },
    {
      "name": "Corr",
      "param": ["correlation_window"],
      "input": ["rank_stable_range", "rank_stable_volume"],
      "output": "range_volume_correlation"
    },
    {
      "name": "Ma",
      "param": ["smooth_window"],
      "input": ["range_volume_correlation"],
      "output": "smoothed_correlation"
    },
    {
      "name": "Zscore",
      "param": ["zscore_window"],
      "input": ["smoothed_correlation"],
      "output": "alignment_zscore"
    },
    {
      "name": "Delay",
      "param": ["confirmation_lag"],
      "input": ["alignment_zscore"],
      "output": "prior_alignment_zscore"
    },
    {
      "name": "Sign",
      "param": [],
      "input": ["alignment_zscore"],
      "output": "alignment_zscore_sign"
    },
    {
      "name": "Sign",
      "param": [],
      "input": ["prior_alignment_zscore"],
      "output": "prior_alignment_zscore_sign"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["alignment_zscore_sign", "prior_alignment_zscore_sign"],
      "output": "sign_agreement"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["sign_agreement", "sign_agreement"],
      "output": "agreement_zero_threshold"
    },
    {
      "name": "Greater",
      "param": [],
      "input": ["sign_agreement", "agreement_zero_threshold"],
      "output": "positive_sign_agreement"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["alignment_zscore", "positive_sign_agreement"],
      "output": "persistent_range_volume_alignment"
    }
