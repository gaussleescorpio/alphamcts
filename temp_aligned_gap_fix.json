{
  "formula": [
    {"name": "Delay", "param": ["close_lag_period"], "input": ["close"], "output": "prior_close"},
    {"name": "Sub", "param": [], "input": ["open", "prior_close"], "output": "overnight_gap"},
    {"name": "Sub", "param": [], "input": ["close", "open"], "output": "intraday_return"},
    {"name": "Abs", "param": [], "input": ["overnight_gap"], "output": "abs_overnight_gap"},
    {"name": "Med", "param": ["normalization_window"], "input": ["abs_overnight_gap"], "output": "median_abs_gap"},
    {"name": "Sub", "param": [], "input": ["abs_overnight_gap", "median_abs_gap"], "output": "abs_gap_excess"},
    {"name": "Greater", "param": [], "input": ["abs_overnight_gap", "median_abs_gap"], "output": "abs_gap_exceeds_median"},
    {"name": "Mul", "param": [], "input": ["abs_gap_exceeds_median", "abs_gap_excess"], "output": "floored_gap_adjustment"},
    {"name": "Add", "param": [], "input": ["floored_gap_adjustment", "median_abs_gap"], "output": "gap_denominator"},
    {"name": "Div", "param": [], "input": ["intraday_return", "gap_denominator"], "output": "normalized_intraday"},
    {"name": "Zscore", "param": ["normalization_window"], "input": ["normalized_intraday"], "output": "gap_zscore"},
    {"name": "Rank", "param": ["normalization_window"], "input": ["gap_zscore"], "output": "gap_rank"},
    {"name": "Sign", "param": [], "input": ["gap_zscore"], "output": "gap_sign"},
    {"name": "Sign", "param": [], "input": ["intraday_return"], "output": "intraday_sign"},
    {"name": "Mul", "param": [], "input": ["intraday_sign", "volume"], "output": "signed_volume"},
    {"name": "Sum", "param": ["sponsorship_window"], "input": ["signed_volume"], "output": "signed_volume_sum"},
    {"name": "Sum", "param": ["sponsorship_window"], "input": ["volume"], "output": "total_volume_sum"},
    {"name": "Div", "param": [], "input": ["signed_volume_sum", "total_volume_sum"], "output": "volume_imbalance"},
    {"name": "Sign", "param": [], "input": ["volume_imbalance"], "output": "volume_imbalance_sign"},
    {"name": "Sign", "param": [], "input": ["normalized_intraday"], "output": "normalized_intraday_sign"},
    {"name": "Mul", "param": [], "input": ["normalized_intraday_sign", "volume_imbalance_sign"], "output": "sign_product"},
    {"name": "Neg", "param": [], "input": ["sign_product"], "output": "neg_sign_product"},
    {"name": "Greater", "param": [], "input": ["sign_product", "neg_sign_product"], "output": "daily_alignment"},
    {"name": "Ma", "param": ["sponsorship_window"], "input": ["daily_alignment"], "output": "sponsorship_persistence"},
    {"name": "Zscore", "param": ["normalization_window"], "input": ["sponsorship_persistence"], "output": "sponsorship_zscore"},
    {"name": "Rank", "param": ["normalization_window"], "input": ["sponsorship_zscore"], "output": "sponsorship_rank"},
    {"name": "Mul", "param": [], "input": ["sponsorship_rank", "gap_sign"], "output": "interaction_term"},
    {"name": "Mul", "param": [], "input": ["interaction_term", "daily_alignment"], "output": "gated_interaction"},
    {"name": "Add", "param": [], "input": ["gap_rank", "gated_interaction"], "output": "alpha"}
  ],
  "arguments": [
    {"close_lag_period": 1, "normalization_window": 20, "sponsorship_window": 10},
    {"close_lag_period": 1, "normalization_window": 60, "sponsorship_window": 20},
    {"close_lag_period": 1, "normalization_window": 40, "sponsorship_window": 15}
  ]
}
