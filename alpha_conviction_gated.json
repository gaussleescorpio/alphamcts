    {"name": "Greater", "param": [], "input": ["blended_corr", "tanh_blended"], "output": "gate_indicator"},
    {"name": "Mul", "param": [], "input": ["tanh_blended", "gate_indicator"], "output": "gated_attention"},
    {"name": "Rank", "param": ["feature_window"], "input": ["gated_attention"], "output": "attention_ts_rank"},
    {"name": "Sub", "param": [], "input": ["close", "vwap"], "output": "vwap_deviation"},
    {"name": "Div", "param": [], "input": ["vwap_deviation", "vwap"], "output": "vwap_deviation_pct"},
    {"name": "Zscore", "param": ["feature_window"], "input": ["vwap_deviation_pct"], "output": "vwap_z"},
    {"name": "Neg", "param": [], "input": ["vwap_z"], "output": "vwap_stretch_score"},
    {"name": "Rank", "param": ["feature_window"], "input": ["vwap_stretch_score"], "output": "vwap_ts_rank"},
    {"name": "Rank", "param": ["feature_window"], "input": ["attention_ts_rank"], "output": "attention_leg_rank"},
    {"name": "Add", "param": [], "input": ["attention_leg_rank", "vwap_ts_rank"], "output": "rank_sum"},
    {"name": "Sub", "param": [], "input": ["attention_leg_rank", "vwap_ts_rank"], "output": "leg_rank_diff"},
    {"name": "Abs", "param": [], "input": ["leg_rank_diff"], "output": "abs_leg_rank_diff"},
    {"name": "Sub", "param": [], "input": ["rank_sum", "abs_leg_rank_diff"], "output": "min_leg_numerator"},
    {"name": "Div", "param": [], "input": ["min_leg_numerator", "corr_divisor"], "output": "min_leg_rank"},
    {"name": "Add", "param": [], "input": ["rank_sum", "abs_leg_rank_diff"], "output": "max_leg_numerator"},
    {"name": "Div", "param": [], "input": ["max_leg_numerator", "corr_divisor"], "output": "max_leg_rank"},
    {"name": "Div", "param": [], "input": ["min_leg_rank", "max_leg_rank"], "output": "leg_alignment"},
    {"name": "Neg", "param": [], "input": ["blended_corr"], "output": "neg_blended_corr"},
