{
  "formula": [
    {"name": "Add", "param": [], "input": ["close", "close"], "output": "close_doubled"},
    {"name": "Add", "param": [], "input": ["high", "low"], "output": "hl_sum"},
    {"name": "Sub", "param": [], "input": ["close_doubled", "hl_sum"], "output": "range_numerator"},
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "range_denominator"},
    {"name": "Div", "param": [], "input": ["range_numerator", "range_denominator"], "output": "range_position"},
    {"name": "Zscore", "param": ["feature_window"], "input": ["volume"], "output": "volume_z"},
    {"name": "Zscore", "param": ["feature_window"], "input": ["range_position"], "output": "position_z"},
    {"name": "Corr", "param": ["short_corr_window"], "input": ["volume_z", "position_z"], "output": "corr_short"},
    {"name": "Corr", "param": ["feature_window"], "input": ["volume_z", "position_z"], "output": "corr_long"},
