    {"name": "Ma", "param": ["signal_smooth_window"], "input": ["conviction_gated_sum"], "output": "smoothed_signal"},
    {"name": "Rank", "param": ["feature_window"], "input": ["smoothed_signal"], "output": "alpha"}
