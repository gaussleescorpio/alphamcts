{
  "formula": [
    {"name": "Diff", "param": ["return_lag"], "input": ["close"], "output": "daily_return"},
    {"name": "Log", "param": [], "input": ["volume"], "output": "log_volume"},
    {"name": "Diff", "param": ["return_lag"], "input": ["log_volume"], "output": "log_volume_change"},
    {"name": "Std", "param": ["correlation_window"], "input": ["daily_return"], "output": "return_volatility"},
    {"name": "Std", "param": ["correlation_window"], "input": ["log_volume_change"], "output": "volume_change_volatility"},
    {"name": "Div", "param": [], "input": ["daily_return", "return_volatility"], "output": "standardized_return"},
    {"name": "Delay", "param": ["return_lag"], "input": ["close"], "output": "prev_close_1"},
    {"name": "Delay", "param": ["return_lag"], "input": ["prev_close_1"], "output": "prev_close_2"},
    {"name": "Delay", "param": ["return_lag"], "input": ["prev_close_2"], "output": "prev_close_3"},
    {"name": "Sub", "param": [], "input": ["close", "prev_close_2"], "output": "lagged_return_2"},
    {"name": "Sub", "param": [], "input": ["close", "prev_close_3"], "output": "lagged_return_3"},
    {"name": "Corr", "param": ["correlation_window"], "input": ["daily_return", "lagged_return_2"], "output": "persistence_lag2_short"},
    {"name": "Corr", "param": ["correlation_window"], "input": ["daily_return", "lagged_return_3"], "output": "persistence_lag3_short"},
    {"name": "Corr", "param": ["normalization_window"], "input": ["daily_return", "lagged_return_2"], "output": "persistence_lag2_long"},
    {"name": "Corr", "param": ["normalization_window"], "input": ["daily_return", "lagged_return_3"], "output": "persistence_lag3_long"},
    {"name": "Add", "param": [], "input": ["persistence_lag2_short", "persistence_lag3_short"], "output": "persistence_short_sum"},
    {"name": "Add", "param": [], "input": ["persistence_lag2_long", "persistence_lag3_long"], "output": "persistence_long_sum"},
    {"name": "Add", "param": [], "input": ["persistence_short_sum", "persistence_long_sum"], "output": "persistence_sum"},
    {"name": "Add", "param": [], "input": ["return_volatility", "volume_change_volatility"], "output": "risk_denominator"},
    {"name": "Div", "param": [], "input": ["persistence_sum", "risk_denominator"], "output": "risk_normalized_persistence"},
    {"name": "Corr", "param": ["correlation_window"], "input": ["standardized_return", "log_volume_change"], "output": "standardized_return_volume_corr"},
    {"name": "Corr", "param": ["correlation_window"], "input": ["daily_return", "log_volume_change"], "output": "short_return_volume_corr"},
    {"name": "Corr", "param": ["normalization_window"], "input": ["daily_return", "log_volume_change"], "output": "long_return_volume_corr"},
    {"name": "Abs", "param": [], "input": ["short_return_volume_corr"], "output": "short_corr_abs"},
    {"name": "Abs", "param": [], "input": ["long_return_volume_corr"], "output": "long_corr_abs"},
    {"name": "Min", "param": ["correlation_window"], "input": ["short_corr_abs"], "output": "min_corr_abs"},
    {"name": "Max", "param": ["correlation_window"], "input": ["long_corr_abs"], "output": "max_corr_abs"},
    {"name": "Div", "param": [], "input": ["min_corr_abs", "max_corr_abs"], "output": "corr_agreement_ratio"},
    {"name": "Mul", "param": [], "input": ["standardized_return_volume_corr", "corr_agreement_ratio"], "output": "volume_confirmation"},
    {"name": "Mul", "param": [], "input": ["risk_normalized_persistence", "volume_confirmation"], "output": "raw_interaction"},
    {"name": "Ma", "param": ["correlation_window"], "input": ["daily_return"], "output": "daily_return_ma"},
    {"name": "Sign", "param": [], "input": ["daily_return_ma"], "output": "drift_direction"},
    {"name": "Sign", "param": [], "input": ["persistence_lag3_short"], "output": "persistence_sign"},
    {"name": "Mul", "param": [], "input": ["drift_direction", "persistence_sign"], "output": "drift_persistence_product"},
    {"name": "Sub", "param": [], "input": ["drift_persistence_product", "drift_persistence_product"], "output": "zero"},
    {"name": "Greater", "param": [], "input": ["drift_persistence_product", "zero"], "output": "sign_agreement"},
    {"name": "Mul", "param": [], "input": ["drift_direction", "sign_agreement"], "output": "directional_gate"},
    {"name": "Mul", "param": [], "input": ["raw_interaction", "directional_gate"], "output": "gated_signal"},
    {"name": "Ma", "param": ["correlation_window"], "input": ["gated_signal"], "output": "smoothed_signal"},
    {"name": "Zscore", "param": ["normalization_window"], "input": ["smoothed_signal"], "output": "alpha"}
  ],
  "arguments": [
    {"return_lag": 1, "correlation_window": 20, "normalization_window": 60},
    {"return_lag": 1, "correlation_window": 10, "normalization_window": 40},
    {"return_lag": 1, "correlation_window": 30, "normalization_window": 90}
  ]
}
