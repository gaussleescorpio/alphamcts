      "param": ["lookback_period"],
      "input": ["vwap_deviation"],
      "output": "deviation_zscore"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["high", "low"],
      "output": "daily_range"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "low"],
      "output": "close_minus_low"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_minus_low", "daily_range"],
      "output": "close_range_position"
