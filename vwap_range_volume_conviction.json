{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "close_vwap_spread"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_vwap_spread", "vwap"],
