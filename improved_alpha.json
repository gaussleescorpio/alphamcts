{
  "name": "vwap_gap_participation_flow_alpha",
  "description": "Compares where the close sits versus VWAP within the day's range, scaled by how meaningful that range is relative to recent activity. Sustained open-to-close direction (not single-day noise) modulates the signal, and range–volume co-movement only increases magnitude when participation supports the move—never flipping sign on weak liquidity days. The result is smoothed, then normalized over each stock's own history and again over a shorter window for stable cross-period ranking.",
  "pseudo_code": [
    "day_range = Sub(input=[high, low], param=[])",
    "close_minus_low = Sub(input=[close, low], param=[])",
    "close_position_in_range = Div(input=[close_minus_low, day_range], param=[])",
    "vwap_minus_low = Sub(input=[vwap, low], param=[])",
    "vwap_position_in_range = Div(input=[vwap_minus_low, day_range], param=[])",
    "vwap_position_gap = Sub(input=[close_position_in_range, vwap_position_in_range], param=[])",
    "range_over_vwap = Div(input=[day_range, vwap], param=[])",
    "avg_range_intensity = Ma(input=[range_over_vwap], param=[medium_window])",
    "vwap_times_avg_range = Mul(input=[vwap, avg_range_intensity], param=[])",
    "range_denominator = Add(input=[day_range, vwap_times_avg_range], param=[])",
    "range_magnitude_scale = Div(input=[day_range, range_denominator], param=[])",
    "gated_vwap_gap = Mul(input=[vwap_position_gap, range_magnitude_scale], param=[])",
    "close_minus_open = Sub(input=[close, open], param=[])",
    "open_close_range_fraction = Div(input=[close_minus_open, day_range], param=[])",
    "smoothed_open_close_flow = Ma(input=[open_close_range_fraction], param=[flow_window])",
    "persistent_flow_gate = Tanh(input=[smoothed_open_close_flow], param=[])",
    "flow_modulated_gap = Mul(input=[gated_vwap_gap, persistent_flow_gate], param=[])",
    "range_volume_corr = Corr(input=[range_over_vwap, volume], param=[medium_window])",
    "zero_reference = Sub(input=[close, close], param=[])",
    "corr_positive_indicator = Greater(input=[range_volume_corr, zero_reference], param=[])",
    "one_sided_range_volume_corr = Mul(input=[range_volume_corr, corr_positive_indicator], param=[])",
    "participation_weight = Ma(input=[one_sided_range_volume_corr], param=[long_window])",
    "participation_scaled_signal = Mul(input=[flow_modulated_gap, participation_weight], param=[])",
    "smoothed_composite = Ma(input=[participation_scaled_signal], param=[medium_window])",
    "issuer_ts_rank = Rank(input=[smoothed_composite], param=[long_window])",
    "alpha = Rank(input=[issuer_ts_rank], param=[medium_window])"
  ]
}
