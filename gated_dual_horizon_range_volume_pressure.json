  "arguments": [
    {"price_scale_window": 20, "short_corr_window": 20, "long_corr_window": 60},
    {"price_scale_window": 10, "short_corr_window": 15, "long_corr_window": 45},
    {"price_scale_window": 30, "short_corr_window": 30, "long_corr_window": 90}
