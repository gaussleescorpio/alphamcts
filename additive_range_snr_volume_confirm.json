{
  "formula": [
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "price_range"},
    {"name": "Sub", "param": [], "input": ["close", "open"], "output": "open_to_close_move"},
    {"name": "Div", "param": [], "input": ["open_to_close_move", "price_range"], "output": "intraday_efficiency"},
    {"name": "Rank", "param": ["range_window"], "input": ["intraday_efficiency"], "output": "ranked_efficiency"},
    {"name": "Ma", "param": ["range_window"], "input": ["ranked_efficiency"], "output": "smoothed_ranked_efficiency"},
    {"name": "Std", "param": ["range_window"], "input": ["ranked_efficiency"], "output": "efficiency_dispersion"},
    {"name": "Med", "param": ["range_window"], "input": ["efficiency_dispersion"], "output": "volatility_floor"},
    {"name": "Sub", "param": [], "input": ["efficiency_dispersion", "volatility_floor"], "output": "dispersion_excess"},
    {"name": "Greater", "param": [], "input": ["efficiency_dispersion", "volatility_floor"], "output": "dispersion_above_floor"},
    {"name": "Mul", "param": [], "input": ["dispersion_above_floor", "dispersion_excess"], "output": "conditional_excess"},
    {"name": "Add", "param": [], "input": ["conditional_excess", "volatility_floor"], "output": "bounded_dispersion"},
    {"name": "Div", "param": [], "input": ["smoothed_ranked_efficiency", "bounded_dispersion"], "output": "efficiency_snr"},
    {"name": "Rank", "param": ["range_window"], "input": ["efficiency_snr"], "output": "ranked_efficiency_snr"},
    {"name": "Diff", "param": ["direction_lag"], "input": ["close"], "output": "close_diff"},
    {"name": "Sign", "param": [], "input": ["close_diff"], "output": "price_direction"},
    {"name": "Diff", "param": ["direction_lag"], "input": ["volume"], "output": "volume_diff"},
    {"name": "Sign", "param": [], "input": ["volume_diff"], "output": "volume_direction"},
    {"name": "Mul", "param": [], "input": ["price_direction", "volume_direction"], "output": "direction_alignment"},
    {"name": "Ma", "param": ["confirmation_window"], "input": ["direction_alignment"], "output": "smoothed_alignment"},
    {"name": "Rank", "param": ["confirmation_window"], "input": ["smoothed_alignment"], "output": "ranked_volume_confirmation"},
    {"name": "Add", "param": [], "input": ["ranked_efficiency_snr", "ranked_volume_confirmation"], "output": "combined_signal"},
    {"name": "Ma", "param": ["smooth_window"], "input": ["combined_signal"], "output": "smoothed_composite"},
    {"name": "Rank", "param": ["smooth_window"], "input": ["smoothed_composite"], "output": "alpha"}
  ],
  "arguments": [
    {"range_window": 20, "confirmation_window": 10, "smooth_window": 5, "direction_lag": 1},
    {"range_window": 60, "confirmation_window": 20, "smooth_window": 10, "direction_lag": 1},
    {"range_window": 10, "confirmation_window": 5, "smooth_window": 3, "direction_lag": 1}
  ]
