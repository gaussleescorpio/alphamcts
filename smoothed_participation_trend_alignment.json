{
  "formula": [
    {
      "name": "Pct",
      "param": ["correlation_window"],
      "input": ["close"],
      "output": "close_return"
    },
    {
      "name": "Pct",
      "param": ["correlation_window"],
      "input": ["volume"],
      "output": "volume_return"
    },
    {
      "name": "Pct",
      "param": ["correlation_window"],
      "input": ["vwap"],
      "output": "vwap_return"
    },
    {
      "name": "Corr",
      "param": ["correlation_window"],
      "input": ["close_return", "volume_return"],
      "output": "price_volume_corr"
    },
    {
      "name": "Corr",
      "param": ["correlation_window"],
      "input": ["close_return", "vwap_return"],
      "output": "price_vwap_corr"
    },
    {
      "name": "Zscore",
      "param": ["correlation_window"],
      "input": ["price_volume_corr"],
      "output": "standardized_price_volume_corr"
    },
    {
      "name": "Zscore",
      "param": ["correlation_window"],
      "input": ["price_vwap_corr"],
      "output": "standardized_price_vwap_corr"
    },
    {
      "name": "Tanh",
      "param": [],
      "input": ["standardized_price_volume_corr"],
      "output": "bounded_price_volume_corr"
    },
    {
      "name": "Tanh",
      "param": [],
      "input": ["standardized_price_vwap_corr"],
      "output": "bounded_price_vwap_corr"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["bounded_price_volume_corr", "bounded_price_vwap_corr"],
      "output": "correlation_composite"
    },
    {
      "name": "Ma",
      "param": ["smoothing_window"],
      "input": ["correlation_composite"],
      "output": "smoothed_composite"
    },
    {
      "name": "Zscore",
      "param": ["normalization_window"],
      "input": ["smoothed_composite"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "correlation_window": 20,
      "smoothing_window": 5,
      "normalization_window": 20
    },
    {
      "correlation_window": 40,
      "smoothing_window": 10,
      "normalization_window": 40
    },
    {
      "correlation_window": 60,
      "smoothing_window": 15,
      "normalization_window": 60
    }
  ]
}
