{
  "formula": [
    {"name": "Sub", "param": [], "input": ["close", "vwap"], "output": "vwap_gap"},
    {"name": "Std", "param": ["lookback_period"], "input": ["close"], "output": "close_volatility"},
    {"name": "Div", "param": [], "input": ["vwap_gap", "close_volatility"], "output": "scaled_vwap_gap"},
    {"name": "Ma", "param": ["persistence_window"], "input": ["scaled_vwap_gap"], "output": "smoothed_vwap_gap"},
    {"name": "Rank", "param": ["lookback_period"], "input": ["smoothed_vwap_gap"], "output": "gap_order_signal"},
    {"name": "Zscore", "param": ["lookback_period"], "input": ["volume"], "output": "volume_zscore"},
    {"name": "Corr", "param": ["lookback_period"], "input": ["smoothed_vwap_gap", "volume_zscore"], "output": "gap_volume_correlation"},
    {"name": "Greater", "param": [], "input": ["smoothed_vwap_gap", "scaled_vwap_gap"], "output": "is_above_vwap"},
    {"name": "Less", "param": [], "input": ["smoothed_vwap_gap", "scaled_vwap_gap"], "output": "is_below_vwap"},
    {"name": "Neg", "param": [], "input": ["gap_volume_correlation"], "output": "neg_gap_volume_correlation"},
    {"name": "Greater", "param": [], "input": ["gap_volume_correlation", "volume_zscore"], "output": "positive_correlation"},
    {"name": "Less", "param": [], "input": ["gap_volume_correlation", "volume_zscore"], "output": "negative_correlation"},
    {"name": "Mul", "param": [], "input": ["gap_volume_correlation", "positive_correlation"], "output": "bullish_volume_confirm"},
    {"name": "Mul", "param": [], "input": ["neg_gap_volume_correlation", "negative_correlation"], "output": "bearish_volume_confirm"},
    {"name": "Add", "param": [], "input": ["bullish_volume_confirm", "bearish_volume_confirm"], "output": "asymmetric_volume_confirm"},
    {"name": "Delay", "param": ["sign_lag"], "input": ["scaled_vwap_gap"], "output": "prior_scaled_gap"},
    {"name": "Greater", "param": [], "input": ["prior_scaled_gap", "volume_zscore"], "output": "prior_gap_above_volume_z"},
    {"name": "Less", "param": [], "input": ["prior_scaled_gap", "volume_zscore"], "output": "prior_gap_below_volume_z"},
    {"name": "Mul", "param": [], "input": ["is_above_vwap", "prior_gap_above_volume_z"], "output": "stable_above_vwap"},
    {"name": "Mul", "param": [], "input": ["is_below_vwap", "prior_gap_below_volume_z"], "output": "stable_below_vwap"},
    {"name": "Add", "param": [], "input": ["stable_above_vwap", "stable_below_vwap"], "output": "gap_sign_persistence"},
    {"name": "Mul", "param": [], "input": ["gap_order_signal", "asymmetric_volume_confirm"], "output": "confirmed_gap_order"},
    {"name": "Mul", "param": [], "input": ["confirmed_gap_order", "gap_sign_persistence"], "output": "alpha"}
  ],
  "arguments": [
    {"lookback_period": 20, "persistence_window": 5, "sign_lag": 1},
    {"lookback_period": 40, "persistence_window": 10, "sign_lag": 1},
    {"lookback_period": 60, "persistence_window": 8, "sign_lag": 2}
  ]
}
