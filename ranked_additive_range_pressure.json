{
  "formula": [
    {"name": "Sub", "param": [], "input": ["close", "close"], "output": "zero_placeholder"},
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "day_range"},
    {"name": "Sub", "param": [], "input": ["close", "open"], "output": "body_pressure"},
    {"name": "Div", "param": [], "input": ["body_pressure", "day_range"], "output": "range_efficiency"},
    {"name": "Sum", "param": ["short_horizon"], "input": ["range_efficiency"], "output": "short_cumulative_pressure"},
    {"name": "Sum", "param": ["alignment_window"], "input": ["range_efficiency"], "output": "long_cumulative_pressure"},
    {"name": "Ma", "param": ["short_horizon"], "input": ["range_efficiency"], "output": "short_smoothed_pressure"},
    {"name": "Ma", "param": ["short_horizon"], "input": ["volume"], "output": "volume_short_avg"},
    {"name": "Ma", "param": ["alignment_window"], "input": ["volume"], "output": "volume_long_avg"},
    {"name": "Div", "param": [], "input": ["volume_short_avg", "volume_long_avg"], "output": "relative_volume_ratio"},
    {"name": "Rank", "param": ["alignment_window"], "input": ["short_cumulative_pressure"], "output": "ranked_short_pressure"},
    {"name": "Rank", "param": ["alignment_window"], "input": ["long_cumulative_pressure"], "output": "ranked_long_pressure"},
    {"name": "Rank", "param": ["alignment_window"], "input": ["short_smoothed_pressure"], "output": "ranked_smoothed_pressure"},
    {"name": "Rank", "param": ["alignment_window"], "input": ["relative_volume_ratio"], "output": "ranked_relative_volume"},
    {"name": "Corr", "param": ["alignment_window"], "input": ["ranked_short_pressure", "ranked_long_pressure"], "output": "pressure_horizon_corr"},
    {"name": "Corr", "param": ["alignment_window"], "input": ["ranked_smoothed_pressure", "ranked_relative_volume"], "output": "pressure_volume_corr"},
    {"name": "Rank", "param": ["alignment_window"], "input": ["pressure_horizon_corr"], "output": "ranked_pressure_corr_leg"},
    {"name": "Rank", "param": ["alignment_window"], "input": ["pressure_volume_corr"], "output": "ranked_volume_corr_leg"},
    {"name": "Rank", "param": ["alignment_window"], "input": ["short_cumulative_pressure"], "output": "ranked_pressure_level_leg"},
    {"name": "Add", "param": [], "input": ["ranked_pressure_corr_leg", "ranked_volume_corr_leg"], "output": "additive_composite_partial"},
    {"name": "Add", "param": [], "input": ["additive_composite_partial", "ranked_pressure_level_leg"], "output": "additive_composite"},
    {"name": "Mul", "param": [], "input": ["pressure_horizon_corr", "pressure_volume_corr"], "output": "corr_alignment_product"},
    {"name": "Greater", "param": [], "input": ["corr_alignment_product", "zero_placeholder"], "output": "correlations_same_sign"},
    {"name": "Abs", "param": [], "input": ["pressure_horizon_corr"], "output": "abs_pressure_horizon_corr"},
    {"name": "Abs", "param": [], "input": ["pressure_volume_corr"], "output": "abs_pressure_volume_corr"},
    {"name": "Greater", "param": [], "input": ["abs_pressure_horizon_corr", "abs_pressure_volume_corr"], "output": "horizon_corr_dominates"},
    {"name": "Less", "param": [], "input": ["abs_pressure_horizon_corr", "abs_pressure_volume_corr"], "output": "volume_corr_dominates"},
    {"name": "Mul", "param": [], "input": ["abs_pressure_horizon_corr", "horizon_corr_dominates"], "output": "min_horizon_branch"},
    {"name": "Mul", "param": [], "input": ["abs_pressure_volume_corr", "volume_corr_dominates"], "output": "min_volume_branch"},
    {"name": "Add", "param": [], "input": ["min_horizon_branch", "min_volume_branch"], "output": "min_corr_magnitude"},
    {"name": "Mul", "param": [], "input": ["correlations_same_sign", "min_corr_magnitude"], "output": "alignment_strength"},
    {"name": "Ma", "param": ["alignment_window"], "input": ["alignment_strength"], "output": "persistence_weight"},
    {"name": "Mul", "param": [], "input": ["additive_composite", "persistence_weight"], "output": "filtered_composite"},
    {"name": "Zscore", "param": ["alignment_window"], "input": ["filtered_composite"], "output": "standardized_signal"},
    {"name": "Ma", "param": ["smooth_window"], "input": ["standardized_signal"], "output": "smoothed_signal"},
    {"name": "Tanh", "param": [], "input": ["smoothed_signal"], "output": "alpha"}
  ],
  "arguments": [
    {"short_horizon": 5, "alignment_window": 60, "smooth_window": 10},
    {"short_horizon": 3, "alignment_window": 40, "smooth_window": 5},
    {"short_horizon": 10, "alignment_window": 90, "smooth_window": 15}
  ]
