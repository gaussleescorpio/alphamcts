{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "vwap_gap_numerator"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["vwap_gap_numerator", "vwap"],
      "output": "vwap_gap_ratio"
    },
    {
      "name": "Diff",
      "param": ["price_change_lag"],
      "input": ["close"],
      "output": "daily_price_change"
    },
    {
      "name": "Std",
      "param": ["volatility_window"],
      "input": ["daily_price_change"],
      "output": "return_volatility"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["vwap_gap_ratio", "return_volatility"],
      "output": "volatility_scaled_gap"
    },
    {
      "name": "Zscore",
      "param": ["fair_value_window"],
      "input": ["volatility_scaled_gap"],
      "output": "fair_value_zscore"
    },
    {
      "name": "Neg",
      "param": [],
      "input": ["fair_value_zscore"],
      "output": "mean_reversion_signal"
    },
    {
      "name": "Corr",
      "param": ["flow_confirm_window"],
      "input": ["volume", "daily_price_change"],
      "output": "volume_return_corr"
    },
    {
      "name": "Rank",
      "param": ["flow_confirm_window"],
      "input": ["volume_return_corr"],
      "output": "flow_alignment_rank"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["mean_reversion_signal", "flow_alignment_rank"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "price_change_lag": 1,
      "volatility_window": 20,
      "fair_value_window": 60,
      "flow_confirm_window": 40
    },
    {
      "price_change_lag": 1,
      "volatility_window": 10,
      "fair_value_window": 40,
      "flow_confirm_window": 60
    },
    {
      "price_change_lag": 1,
      "volatility_window": 30,
      "fair_value_window": 90,
      "flow_confirm_window": 50
    }
  ]
}
