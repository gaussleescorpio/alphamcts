{
  "formula": [
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "daily_range"},
    {"name": "Med", "param": ["efficiency_window"], "input": ["daily_range"], "output": "median_daily_range"},
    {"name": "Sub", "param": [], "input": ["median_daily_range", "daily_range"], "output": "range_excess_vs_median"},
    {"name": "Greater", "param": [], "input": ["median_daily_range", "daily_range"], "output": "median_range_exceeds_current"},
    {"name": "Mul", "param": [], "input": ["median_range_exceeds_current", "range_excess_vs_median"], "output": "range_dampening_term"},
    {"name": "Add", "param": [], "input": ["daily_range", "range_dampening_term"], "output": "damped_daily_range"},
    {"name": "Sub", "param": [], "input": ["close", "open"], "output": "open_to_close_body"},
    {"name": "Div", "param": [], "input": ["open_to_close_body", "damped_daily_range"], "output": "range_efficiency"},
    {"name": "Ma", "param": ["efficiency_window"], "input": ["range_efficiency"], "output": "smoothed_range_efficiency"},
    {"name": "Std", "param": ["regime_window"], "input": ["range_efficiency"], "output": "range_efficiency_volatility"},
    {"name": "Ma", "param": ["efficiency_window"], "input": ["range_efficiency_volatility"], "output": "smoothed_efficiency_volatility"},
    {"name": "Div", "param": [], "input": ["smoothed_range_efficiency", "smoothed_efficiency_volatility"], "output": "efficiency_level_ratio"},
    {"name": "Log", "param": [], "input": ["volume"], "output": "log_volume"},
    {"name": "Delay", "param": ["volume_lag_period"], "input": ["log_volume"], "output": "lagged_log_volume"},
    {"name": "Ma", "param": ["efficiency_window"], "input": ["lagged_log_volume"], "output": "smoothed_lagged_log_volume"},
    {"name": "Corr", "param": ["regime_window"], "input": ["smoothed_range_efficiency", "smoothed_lagged_log_volume"], "output": "slow_efficiency_volume_corr"},
    {"name": "Mul", "param": [], "input": ["efficiency_level_ratio", "slow_efficiency_volume_corr"], "output": "raw_efficiency_liquidity_signal"},
    {"name": "Ma", "param": ["regime_window"], "input": ["raw_efficiency_liquidity_signal"], "output": "smoothed_combined_signal"},
    {"name": "Std", "param": ["regime_window"], "input": ["range_efficiency"], "output": "efficiency_regime_volatility"},
    {"name": "Std", "param": ["regime_window"], "input": ["log_volume"], "output": "volume_regime_volatility"},
    {"name": "Add", "param": [], "input": ["efficiency_regime_volatility", "volume_regime_volatility"], "output": "joint_regime_volatility"},
    {"name": "Ma", "param": ["regime_window"], "input": ["joint_regime_volatility"], "output": "smoothed_joint_regime_volatility"},
    {"name": "Div", "param": [], "input": ["smoothed_combined_signal", "smoothed_joint_regime_volatility"], "output": "alpha"}
  ],
  "arguments": [
    {
      "efficiency_window": 20,
      "regime_window": 20,
      "volume_lag_period": 5
    },
    {
      "efficiency_window": 10,
      "regime_window": 30,
      "volume_lag_period": 3
    },
    {
      "efficiency_window": 40,
      "regime_window": 60,
      "volume_lag_period": 10
    }
  ]
}
