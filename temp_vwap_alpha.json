{
  "formula": [
    {"name": "Sub", "param": [], "input": ["close", "vwap"], "output": "close_minus_vwap"},
    {"name": "Div", "param": [], "input": ["close_minus_vwap", "vwap"], "output": "vwap_deviation"},
    {"name": "Zscore", "param": ["zscore_window"], "input": ["vwap_deviation"], "output": "vwap_zscore"},
    {"name": "Pct", "param": ["return_lag_period"], "input": ["close"], "output": "daily_return"},
    {"name": "Std", "param": ["accumulation_window"], "input": ["daily_return"], "output": "return_volatility"},
    {"name": "Ma", "param": ["accumulation_window"], "input": ["volume"], "output": "recent_volume"},
    {"name": "Delay", "param": ["accumulation_window"], "input": ["recent_volume"], "output": "lagged_volume"},
    {"name": "Div", "param": [], "input": ["recent_volume", "lagged_volume"], "output": "volume_ratio"},
    {"name": "Log", "param": [], "input": ["volume_ratio"], "output": "volume_log_trend"},
    {"name": "Div", "param": [], "input": ["vwap_zscore", "return_volatility"], "output": "vol_adjusted_pressure"},
    {"name": "Mul", "param": [], "input": ["vol_adjusted_pressure", "volume_log_trend"], "output": "pressure_term"},
    {"name": "Sum", "param": ["accumulation_window"], "input": ["pressure_term"], "output": "vwap_pressure_integral"},
    {"name": "Mul", "param": [], "input": ["vwap_deviation", "volume"], "output": "vwap_volume_product"},
    {"name": "Sum", "param": ["accumulation_window"], "input": ["vwap_volume_product"], "output": "vwap_volume_sum"},
    {"name": "Sum", "param": ["accumulation_window"], "input": ["volume"], "output": "total_volume_sum"},
    {"name": "Div", "param": [], "input": ["vwap_volume_sum", "total_volume_sum"], "output": "volume_partition_ratio"},
    {"name": "Zscore", "param": ["zscore_window"], "input": ["volume_partition_ratio"], "output": "volume_partition_zscore"},
    {"name": "Ma", "param": ["zscore_window"], "input": ["daily_return"], "output": "mean_daily_return"},
    {"name": "Std", "param": ["zscore_window"], "input": ["daily_return"], "output": "return_dispersion"},
    {"name": "Sum", "param": ["zscore_window"], "input": ["daily_return"], "output": "cumulative_return"},
    {"name": "Abs", "param": [], "input": ["cumulative_return"], "output": "abs_cumulative_return"},
    {"name": "Div", "param": [], "input": ["return_dispersion", "abs_cumulative_return"], "output": "path_efficiency_ratio"},
    {"name": "Sign", "param": [], "input": ["mean_daily_return"], "output": "trend_direction"},
    {"name": "Neg", "param": [], "input": ["path_efficiency_ratio"], "output": "neg_path_efficiency"},
    {"name": "Mul", "param": [], "input": ["trend_direction", "neg_path_efficiency"], "output": "path_efficiency_gate"},
    {"name": "Sign", "param": [], "input": ["vwap_pressure_integral"], "output": "pressure_sign"},
    {"name": "Sign", "param": [], "input": ["volume_partition_zscore"], "output": "partition_sign"},
    {"name": "Mul", "param": [], "input": ["pressure_sign", "partition_sign"], "output": "bilateral_confirmation"},
    {"name": "Rank", "param": ["zscore_window"], "input": ["vwap_pressure_integral"], "output": "pressure_rank"},
    {"name": "Rank", "param": ["zscore_window"], "input": ["volume_partition_zscore"], "output": "partition_rank"},
    {"name": "Rank", "param": ["zscore_window"], "input": ["path_efficiency_gate"], "output": "path_rank"},
    {"name": "Add", "param": [], "input": ["pressure_rank", "partition_rank"], "output": "rank_sum_ab"},
    {"name": "Add", "param": [], "input": ["rank_sum_ab", "path_rank"], "output": "rank_blend"},
    {"name": "Mul", "param": [], "input": ["rank_blend", "bilateral_confirmation"], "output": "alpha"}
  ],
  "arguments": [
    {"zscore_window": 20, "accumulation_window": 10, "return_lag_period": 1},
    {"zscore_window": 40, "accumulation_window": 20, "return_lag_period": 1},
    {"zscore_window": 60, "accumulation_window": 30, "return_lag_period": 1}
  ]
}
