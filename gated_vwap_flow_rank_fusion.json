    {"name": "Div", "param": [], "input": ["short_avg_volume", "long_avg_volume"], "output": "relative_volume"},
    {"name": "Med", "param": ["rank_window"], "input": ["relative_volume"], "output": "volume_participation_threshold"},
    {"name": "Greater", "param": [], "input": ["relative_volume", "volume_participation_threshold"], "output": "participation_gate"},
    {"name": "Mul", "param": [], "input": ["cheapness_signal", "participation_gate"], "output": "gated_cheapness"},
    {"name": "Diff", "param": ["smooth_window"], "input": ["vwap_gap"], "output": "vwap_gap_change"},
