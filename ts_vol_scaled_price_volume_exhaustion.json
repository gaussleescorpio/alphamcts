{
  "formula": [
    {"name": "Min", "param": ["range_window"], "input": ["low"], "output": "price_range_low"},
    {"name": "Max", "param": ["range_window"], "input": ["high"], "output": "price_range_high"},
    {"name": "Sub", "param": [], "input": ["price_range_high", "price_range_low"], "output": "range_span"},
    {"name": "Sub", "param": [], "input": ["close", "price_range_low"], "output": "close_above_low"},
    {"name": "Div", "param": [], "input": ["close_above_low", "range_span"], "output": "range_position"},
    {"name": "Ma", "param": ["range_window"], "input": ["range_position"], "output": "smoothed_range_position"},
    {"name": "Ma", "param": ["range_window"], "input": ["volume"], "output": "smoothed_volume"},
    {"name": "Zscore", "param": ["divergence_window"], "input": ["smoothed_range_position"], "output": "price_leg_zscore"},
    {"name": "Zscore", "param": ["divergence_window"], "input": ["smoothed_volume"], "output": "volume_leg_zscore"},
    {"name": "Sub", "param": [], "input": ["price_leg_zscore", "volume_leg_zscore"], "output": "ts_divergence"},
    {"name": "Ma", "param": ["divergence_window"], "input": ["ts_divergence"], "output": "smoothed_divergence"},
    {"name": "Std", "param": ["divergence_window"], "input": ["smoothed_divergence"], "output": "divergence_volatility"},
    {"name": "Abs", "param": [], "input": ["smoothed_divergence"], "output": "abs_smoothed_divergence"},
    {"name": "Ma", "param": ["divergence_window"], "input": ["abs_smoothed_divergence"], "output": "volatility_floor"},
    {"name": "Sub", "param": [], "input": ["divergence_volatility", "volatility_floor"], "output": "divergence_volatility_excess"},
    {"name": "Greater", "param": [], "input": ["divergence_volatility", "volatility_floor"], "output": "divergence_volatility_dominates"},
    {"name": "Mul", "param": [], "input": ["divergence_volatility_dominates", "divergence_volatility_excess"], "output": "divergence_volatility_adjustment"},
    {"name": "Add", "param": [], "input": ["volatility_floor", "divergence_volatility_adjustment"], "output": "spread_volatility"},
    {"name": "Div", "param": [], "input": ["smoothed_divergence", "spread_volatility"], "output": "vol_scaled_divergence"},
    {"name": "Ma", "param": ["range_window"], "input": ["ts_divergence"], "output": "fast_divergence"},
    {"name": "Ma", "param": ["divergence_window"], "input": ["ts_divergence"], "output": "slow_divergence"},
    {"name": "Abs", "param": [], "input": ["fast_divergence"], "output": "fast_magnitude"},
    {"name": "Abs", "param": [], "input": ["slow_divergence"], "output": "slow_magnitude"},
    {"name": "Sub", "param": [], "input": ["fast_magnitude", "slow_magnitude"], "output": "magnitude_spread"},
    {"name": "Greater", "param": [], "input": ["fast_magnitude", "slow_magnitude"], "output": "fast_exceeds_slow"},
    {"name": "Mul", "param": [], "input": ["fast_exceeds_slow", "magnitude_spread"], "output": "magnitude_adjustment"},
    {"name": "Sub", "param": [], "input": ["fast_magnitude", "magnitude_adjustment"], "output": "agreement_magnitude"},
    {"name": "Sign", "param": [], "input": ["slow_divergence"], "output": "slow_direction"},
    {"name": "Mul", "param": [], "input": ["agreement_magnitude", "slow_direction"], "output": "dual_horizon_gate"},
    {"name": "Ma", "param": ["range_window"], "input": ["close"], "output": "avg_close"},
    {"name": "Div", "param": [], "input": ["range_span", "avg_close"], "output": "normalized_range_width"},
    {"name": "Zscore", "param": ["divergence_window"], "input": ["normalized_range_width"], "output": "range_width_zscore"},
    {"name": "Abs", "param": [], "input": ["range_width_zscore"], "output": "abs_range_width_zscore"},
    {"name": "Sign", "param": [], "input": ["close"], "output": "unit_constant"},
    {"name": "Add", "param": [], "input": ["abs_range_width_zscore", "unit_constant"], "output": "range_quality_base"},
    {"name": "Log", "param": [], "input": ["range_quality_base"], "output": "range_quality_weight"},
    {"name": "Mul", "param": [], "input": ["vol_scaled_divergence", "dual_horizon_gate"], "output": "gated_divergence"},
    {"name": "Mul", "param": [], "input": ["gated_divergence", "range_quality_weight"], "output": "weighted_signal"},
    {"name": "Ma", "param": ["divergence_window"], "input": ["weighted_signal"], "output": "smoothed_signal"},
    {"name": "Zscore", "param": ["normalization_window"], "input": ["smoothed_signal"], "output": "alpha_zscore"},
    {"name": "Neg", "param": [], "input": ["alpha_zscore"], "output": "alpha"}
  ],
  "arguments": [
    {"range_window": 10, "divergence_window": 20, "normalization_window": 60},
    {"range_window": 20, "divergence_window": 40, "normalization_window": 60},
    {"range_window": 15, "divergence_window": 60, "normalization_window": 120}
  ]
}
