{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "close_minus_vwap"
    },
    {
      "name": "Std",
      "param": ["signal_window"],
      "input": ["close"],
      "output": "close_volatility"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_minus_vwap", "close_volatility"],
      "output": "vwap_dislocation_z"
    },
    {
      "name": "Rank",
      "param": ["signal_window"],
      "input": ["vwap_dislocation_z"],
      "output": "vwap_dislocation_rank"
    },
    {
      "name": "Diff",
      "param": ["diff_lag"],
      "input": ["close"],
      "output": "price_change"
    },
    {
      "name": "Diff",
      "param": ["diff_lag"],
      "input": ["volume"],
      "output": "volume_change"
    },
    {
      "name": "Corr",
      "param": ["signal_window"],
      "input": ["price_change", "volume_change"],
      "output": "price_volume_correlation"
    },
    {
      "name": "Rank",
      "param": ["volume_lookback"],
      "input": ["volume"],
      "output": "volume_activity_rank"
    },
    {
      "name": "Sign",
      "param": [],
      "input": ["close_minus_vwap"],
      "output": "vwap_gap_sign"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["vwap_gap_sign", "price_volume_correlation"],
      "output": "signed_flow_coherence"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["volume_activity_rank", "signed_flow_coherence"],
      "output": "volume_confirmed_flow"
    },
    {
      "name": "Rank",
      "param": ["signal_window"],
      "input": ["volume_confirmed_flow"],
      "output": "flow_confirmation_rank"
    },
    {
      "name": "Less",
      "param": [],
      "input": ["vwap_dislocation_rank", "flow_confirmation_rank"],
      "output": "dislocation_is_weaker_rank"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["vwap_dislocation_rank", "flow_confirmation_rank"],
      "output": "rank_spread_dislocation_minus_flow"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["dislocation_is_weaker_rank", "rank_spread_dislocation_minus_flow"],
      "output": "weaker_rank_adjustment"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["flow_confirmation_rank", "weaker_rank_adjustment"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "signal_window": 20,
      "diff_lag": 1,
      "volume_lookback": 60
    },
    {
      "signal_window": 10,
      "diff_lag": 5,
      "volume_lookback": 40
    },
    {
      "signal_window": 40,
      "diff_lag": 3,
      "volume_lookback": 120
    }
  ]
}
