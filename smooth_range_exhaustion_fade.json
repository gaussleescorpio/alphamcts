{
  "formula": [
    {"name": "Div", "param": [], "input": ["close", "close"], "output": "unity"},
    {"name": "Sub", "param": [], "input": ["close", "close"], "output": "zero_level"},
    {"name": "Min", "param": ["range_window"], "input": ["low"], "output": "range_low"},
    {"name": "Max", "param": ["range_window"], "input": ["high"], "output": "range_high"},
    {"name": "Sub", "param": [], "input": ["range_high", "range_low"], "output": "range_span"},
    {"name": "Sub", "param": [], "input": ["close", "range_low"], "output": "close_minus_range_low"},
    {"name": "Div", "param": [], "input": ["close_minus_range_low", "range_span"], "output": "range_position"},
    {"name": "Ma", "param": ["confirmation_window"], "input": ["unity"], "output": "ma_unity_confirmation"},
    {"name": "Sum", "param": ["range_window"], "input": ["unity"], "output": "range_window_scalar"},
    {"name": "Sub", "param": [], "input": ["range_window_scalar", "ma_unity_confirmation"], "output": "tail_threshold_window_expr"},
    {"name": "Sum", "param": ["tail_threshold_sum_window"], "input": ["unity"], "output": "tail_threshold_numerator"},
    {"name": "Sum", "param": ["range_window"], "input": ["unity"], "output": "tail_threshold_denominator"},
    {"name": "Div", "param": [], "input": ["tail_threshold_numerator", "tail_threshold_denominator"], "output": "tail_threshold"},
    {"name": "Sub", "param": [], "input": ["range_position", "tail_threshold"], "output": "tail_excess"},
    {"name": "Greater", "param": [], "input": ["tail_excess", "zero_level"], "output": "tail_active"},
    {"name": "Mul", "param": [], "input": ["tail_excess", "tail_active"], "output": "positive_tail"},
    {"name": "Square", "param": [], "input": ["positive_tail"], "output": "tail_weight"},
    {"name": "Ma", "param": ["confirmation_window"], "input": ["tail_weight"], "output": "smoothed_tail"},
    {"name": "Sum", "param": ["confirmation_window"], "input": ["unity"], "output": "confirmation_window_scalar"},
    {"name": "Sub", "param": [], "input": ["confirmation_window_scalar", "ma_unity_confirmation"], "output": "confirmation_min_window_expr"},
    {"name": "Sum", "param": ["confirmation_min_sum_window"], "input": ["unity"], "output": "confirmation_min_numerator"},
    {"name": "Sum", "param": ["confirmation_window"], "input": ["unity"], "output": "confirmation_min_denominator"},
    {"name": "Div", "param": [], "input": ["confirmation_min_numerator", "confirmation_min_denominator"], "output": "confirmation_min"},
    {"name": "Ma", "param": ["confirmation_window"], "input": ["tail_active"], "output": "ma_tail_active"},
    {"name": "Greater", "param": [], "input": ["ma_tail_active", "confirmation_min"], "output": "ma_tail_active_above_min"},
    {"name": "Mul", "param": [], "input": ["ma_tail_active", "ma_tail_active_above_min"], "output": "confirmation_filter"},
    {"name": "Greater", "param": [], "input": ["close", "open"], "output": "is_up_day"},
    {"name": "Mul", "param": [], "input": ["is_up_day", "volume"], "output": "up_day_volume_contrib"},
    {"name": "Sum", "param": ["range_window"], "input": ["up_day_volume_contrib"], "output": "up_day_volume"},
    {"name": "Less", "param": [], "input": ["close", "open"], "output": "is_down_day"},
    {"name": "Mul", "param": [], "input": ["is_down_day", "volume"], "output": "down_day_volume_contrib"},
    {"name": "Sum", "param": ["range_window"], "input": ["down_day_volume_contrib"], "output": "down_day_volume"},
    {"name": "Sub", "param": [], "input": ["up_day_volume", "down_day_volume"], "output": "net_directional_volume"},
    {"name": "Sum", "param": ["range_window"], "input": ["volume"], "output": "total_volume"},
    {"name": "Div", "param": [], "input": ["net_directional_volume", "total_volume"], "output": "volume_pressure"},
    {"name": "Neg", "param": [], "input": ["volume_pressure"], "output": "volume_asymmetry"},
    {"name": "Mul", "param": [], "input": ["smoothed_tail", "confirmation_filter"], "output": "tail_confirmed"},
    {"name": "Mul", "param": [], "input": ["tail_confirmed", "volume_asymmetry"], "output": "core_signal"},
    {"name": "Ma", "param": ["range_window"], "input": ["core_signal"], "output": "core_signal_mean"},
    {"name": "Sub", "param": [], "input": ["core_signal", "core_signal_mean"], "output": "signal_demeaned"},
    {"name": "Std", "param": ["range_window"], "input": ["close"], "output": "close_volatility"},
    {"name": "Rank", "param": ["range_window"], "input": ["close_volatility"], "output": "volatility_rank"},
    {"name": "Ma", "param": ["range_window"], "input": ["volume"], "output": "volume_baseline"},
    {"name": "Div", "param": [], "input": ["volume_baseline", "volume"], "output": "volume_baseline_ratio"},
    {"name": "Rank", "param": ["range_window"], "input": ["volume_baseline_ratio"], "output": "liquidity_rank"},
    {"name": "Add", "param": [], "input": ["volatility_rank", "liquidity_rank"], "output": "control_factor"},
    {"name": "TsRegress", "param": ["range_window"], "input": ["control_factor", "signal_demeaned"], "output": "regression_slope"},
    {"name": "Mul", "param": [], "input": ["regression_slope", "control_factor"], "output": "projected_component"},
    {"name": "Sub", "param": [], "input": ["signal_demeaned", "projected_component"], "output": "orthogonal_residual"},
    {"name": "Delay", "param": ["residual_smooth_window"], "input": ["orthogonal_residual"], "output": "prior_residual"},
    {"name": "Sum", "param": ["residual_smooth_window"], "input": ["unity"], "output": "residual_smooth_window_scalar"},
    {"name": "Sub", "param": [], "input": ["residual_smooth_window_scalar", "ma_unity_confirmation"], "output": "decay_weight_window_expr"},
    {"name": "Sum", "param": ["decay_weight_sum_window"], "input": ["unity"], "output": "decay_weight_numerator"},
    {"name": "Sum", "param": ["residual_smooth_window"], "input": ["unity"], "output": "decay_weight_denominator"},
    {"name": "Div", "param": [], "input": ["decay_weight_numerator", "decay_weight_denominator"], "output": "decay_weight"},
    {"name": "Sub", "param": [], "input": ["unity", "decay_weight"], "output": "fresh_weight"},
    {"name": "Mul", "param": [], "input": ["prior_residual", "decay_weight"], "output": "prior_residual_weighted"},
    {"name": "Mul", "param": [], "input": ["orthogonal_residual", "fresh_weight"], "output": "orthogonal_residual_weighted"},
    {"name": "Add", "param": [], "input": ["prior_residual_weighted", "orthogonal_residual_weighted"], "output": "alpha"}
  ],
  "arguments": [
    {
