    {
      "name": "Corr",
      "param": ["long_correlation_window"],
      "input": ["smoothed_close_in_range", "volume_activity_rank"],
      "output": "long_horizon_corr"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["short_horizon_corr", "short_horizon_corr"],
      "output": "short_horizon_corr_normalized"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["long_horizon_corr", "long_horizon_corr"],
      "output": "long_horizon_corr_normalized"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["short_horizon_corr_normalized", "long_horizon_corr_normalized"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "rank_window": 20,
      "short_correlation_window": 10,
      "long_correlation_window": 60
    },
    {
      "rank_window": 40,
      "short_correlation_window": 20,
