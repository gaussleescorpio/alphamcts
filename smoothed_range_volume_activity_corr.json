{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["high", "low"],
      "output": "daily_range"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "low"],
      "output": "close_above_low"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_above_low", "daily_range"],
      "output": "close_in_range"
    },
    {
      "name": "Rank",
      "param": ["rank_window"],
      "input": ["close_in_range"],
      "output": "close_in_range_rank"
    },
    {
      "name": "Ma",
      "param": ["rank_window"],
      "input": ["close_in_range_rank"],
      "output": "smoothed_close_in_range"
    },
    {
      "name": "Ma",
      "param": ["rank_window"],
      "input": ["volume"],
      "output": "average_volume"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["volume", "average_volume"],
      "output": "relative_volume"
    },
    {
      "name": "Rank",
      "param": ["rank_window"],
      "input": ["relative_volume"],
      "output": "volume_activity_rank"
    },
    {
      "name": "Corr",
      "param": ["short_correlation_window"],
      "input": ["smoothed_close_in_range", "volume_activity_rank"],
