    {"name": "Div", "param": [], "input": ["close_change", "close_volatility"], "output": "normalized_close_change"},
    {"name": "Div", "param": [], "input": ["volume_change", "volume_volatility"], "output": "normalized_volume_change"},
    {"name": "Corr", "param": ["lookback_window"], "input": ["normalized_close_change", "normalized_volume_change"], "output": "price_volume_corr"},
    {"name": "Div", "param": [], "input": ["close", "close"], "output": "unit_value"},
    {"name": "Add", "param": [], "input": ["unit_value", "unit_value"], "output": "two_units"},
    {"name": "Add", "param": [], "input": ["unit_value", "price_volume_corr"], "output": "one_plus_price_volume_corr"},
    {"name": "Div", "param": [], "input": ["one_plus_price_volume_corr", "two_units"], "output": "price_volume_confirmation"},
    {"name": "Div", "param": [], "input": ["volume_change", "volume_volatility"], "output": "normalized_volume_flow"},
    {"name": "Ma", "param": ["lookback_window"], "input": ["normalized_volume_flow"], "output": "smoothed_volume_flow"},
    {"name": "Sign", "param": [], "input": ["vwap_drift_core"], "output": "vwap_drift_sign"},
