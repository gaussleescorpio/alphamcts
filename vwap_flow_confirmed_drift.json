    {"name": "Div", "param": [], "input": ["vwap_deviation", "close_volatility"], "output": "normalized_vwap_drift"},
    {"name": "Ma", "param": ["lookback_window"], "input": ["normalized_vwap_drift"], "output": "vwap_drift_core"},
    {"name": "Diff", "param": ["flow_window"], "input": ["close"], "output": "close_change"},
