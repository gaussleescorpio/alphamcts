      "param": ["momentum_window"],
      "input": ["close_location_value"],
      "output": "clv_momentum"
    },
    {
      "name": "Std",
      "param": ["lookback_window"],
      "input": ["close_location_value"],
      "output": "clv_volatility"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["clv_momentum", "clv_volatility"],
      "output": "clv_vol_norm_momentum"
    },
    {
      "name": "Zscore",
      "param": ["lookback_window"],
      "input": ["clv_vol_norm_momentum"],
