    },
    {
      "name": "Sub",
      "param": [],
      "input": ["high", "low"],
      "output": "clv_denominator"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["clv_numerator", "clv_denominator"],
      "output": "close_location_value"
    },
    {
