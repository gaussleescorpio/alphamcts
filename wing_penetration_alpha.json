{
  "formula": [
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "daily_range"},
    {"name": "Sub", "param": [], "input": ["high", "vwap"], "output": "high_minus_vwap"},
    {"name": "Sub", "param": [], "input": ["vwap", "low"], "output": "vwap_minus_low"},
    {"name": "Div", "param": [], "input": ["high_minus_vwap", "daily_range"], "output": "vwap_upper_share"},
    {"name": "Div", "param": [], "input": ["vwap_minus_low", "daily_range"], "output": "vwap_lower_share"},
    {"name": "Sub", "param": [], "input": ["vwap_upper_share", "vwap_lower_share"], "output": "range_asymmetry"},
    {"name": "Greater", "param": [], "input": ["close", "vwap"], "output": "close_above_vwap"},
    {"name": "Less", "param": [], "input": ["close", "vwap"], "output": "close_below_vwap"},
    {"name": "Sub", "param": [], "input": ["close", "vwap"], "output": "close_minus_vwap"},
    {"name": "Div", "param": [], "input": ["close_minus_vwap", "high_minus_vwap"], "output": "upper_wing_penetration"},
    {"name": "Sub", "param": [], "input": ["vwap", "close"], "output": "vwap_minus_close"},
    {"name": "Div", "param": [], "input": ["vwap_minus_close", "vwap_minus_low"], "output": "lower_wing_penetration"},
    {"name": "Mul", "param": [], "input": ["close_above_vwap", "upper_wing_penetration"], "output": "upper_wing_term"},
    {"name": "Mul", "param": [], "input": ["close_below_vwap", "lower_wing_penetration"], "output": "lower_wing_term"},
    {"name": "Add", "param": [], "input": ["upper_wing_term", "lower_wing_term"], "output": "wing_penetration_weight"},
    {"name": "Mul", "param": [], "input": ["range_asymmetry", "wing_penetration_weight"], "output": "asymmetry_signed"},
    {"name": "Div", "param": [], "input": ["close_minus_vwap", "daily_range"], "output": "vwap_gap_normalized"},
    {"name": "Zscore", "param": ["asymmetry_window"], "input": ["asymmetry_signed"], "output": "asymmetry_zscore"},
    {"name": "Zscore", "param": ["gap_fast_window"], "input": ["vwap_gap_normalized"], "output": "gap_zscore_fast"},
    {"name": "Zscore", "param": ["asymmetry_window"], "input": ["vwap_gap_normalized"], "output": "gap_zscore_slow"},
    {"name": "Sub", "param": [], "input": ["gap_zscore_fast", "gap_zscore_slow"], "output": "gap_acceleration"},
    {"name": "Tanh", "param": [], "input": ["gap_acceleration"], "output": "gap_acceleration_tanh"},
    {"name": "Mul", "param": [], "input": ["asymmetry_zscore", "gap_acceleration_tanh"], "output": "asymmetry_accel_term"},
    {"name": "Add", "param": [], "input": ["asymmetry_zscore", "asymmetry_accel_term"], "output": "coupled_signal"},
    {"name": "Ma", "param": ["asymmetry_window"], "input": ["daily_range"], "output": "daily_range_ma"},
    {"name": "Div", "param": [], "input": ["daily_range", "daily_range_ma"], "output": "range_expansion_ratio"},
    {"name": "Rank", "param": ["asymmetry_window"], "input": ["range_expansion_ratio"], "output": "range_expansion_rank"},
    {"name": "Diff", "param": ["confirmation_lag"], "input": ["range_expansion_ratio"], "output": "range_expansion_change"},
    {"name": "Diff", "param": ["confirmation_lag"], "input": ["vwap_gap_normalized"], "output": "dislocation_change"},
    {"name": "Corr", "param": ["asymmetry_window"], "input": ["range_expansion_change", "dislocation_change"], "output": "expansion_dislocation_sync"},
    {"name": "Div", "param": [], "input": ["daily_range", "daily_range"], "output": "unit_one"},
    {"name": "Add", "param": [], "input": ["unit_one", "unit_one"], "output": "two_unit"},
    {"name": "Div", "param": [], "input": ["unit_one", "two_unit"], "output": "half_unit"},
    {"name": "Tanh", "param": [], "input": ["expansion_dislocation_sync"], "output": "expansion_dislocation_sync_tanh"},
    {"name": "Mul", "param": [], "input": ["half_unit", "expansion_dislocation_sync_tanh"], "output": "sync_adjustment"},
    {"name": "Add", "param": [], "input": ["half_unit", "sync_adjustment"], "output": "sync_multiplier"},
    {"name": "Mul", "param": [], "input": ["coupled_signal", "range_expansion_rank"], "output": "coupled_expansion_signal"},
    {"name": "Mul", "param": [], "input": ["coupled_expansion_signal", "sync_multiplier"], "output": "alpha"}
  ],
  "arguments": [
    {"asymmetry_window": 20, "gap_fast_window": 5, "confirmation_lag": 3},
    {"asymmetry_window": 40, "gap_fast_window": 10, "confirmation_lag": 5},
    {"asymmetry_window": 60, "gap_fast_window": 15, "confirmation_lag": 2}
  ]
}
