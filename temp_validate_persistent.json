{
  "formula": [
    {"name": "Sub", "param": [], "input": ["close", "vwap"], "output": "vwap_gap"},
    {"name": "Ma", "param": ["short_window"], "input": ["vwap_gap"], "output": "short_vwap_ma"},
    {"name": "Ma", "param": ["lookback_period"], "input": ["vwap_gap"], "output": "long_vwap_ma"},
    {"name": "Std", "param": ["lookback_period"], "input": ["vwap_gap"], "output": "vwap_gap_volatility"},
    {"name": "Add", "param": [], "input": ["long_vwap_ma", "vwap_gap_volatility"], "output": "vwap_denominator"},
    {"name": "Div", "param": [], "input": ["short_vwap_ma", "vwap_denominator"], "output": "vwap_persistence_ratio"},
    {"name": "Std", "param": ["lookback_period"], "input": ["close"], "output": "close_volatility"},
    {"name": "Div", "param": [], "input": ["vwap_persistence_ratio", "close_volatility"], "output": "vol_adjusted_vwap"},
    {"name": "Rank", "param": ["lookback_period"], "input": ["vol_adjusted_vwap"], "output": "ranked_vwap_leg"},
    {"name": "Diff", "param": ["short_window"], "input": ["close"], "output": "daily_price_change"},
    {"name": "Log", "param": [], "input": ["volume"], "output": "log_volume"},
    {"name": "Corr", "param": ["lookback_period"], "input": ["daily_price_change", "log_volume"], "output": "short_price_volume_corr"},
    {"name": "Corr", "param": ["long_window"], "input": ["daily_price_change", "log_volume"], "output": "long_price_volume_corr"},
    {"name": "Sum", "param": ["lookback_period"], "input": ["volume"], "output": "volume_sum"},
    {"name": "Sign", "param": [], "input": ["volume_sum"], "output": "unit_scaler"},
    {"name": "Add", "param": [], "input": ["unit_scaler", "unit_scaler"], "output": "double_unit_scaler"},
    {"name": "Inverse", "param": [], "input": ["double_unit_scaler"], "output": "blend_weight"},
    {"name": "Add", "param": [], "input": ["short_price_volume_corr", "long_price_volume_corr"], "output": "sum_price_volume_corr"},
    {"name": "Mul", "param": [], "input": ["sum_price_volume_corr", "blend_weight"], "output": "blended_price_volume_corr"},
    {"name": "Rank", "param": ["lookback_period"], "input": ["blended_price_volume_corr"], "output": "ranked_volume_leg"},
    {"name": "Add", "param": [], "input": ["ranked_vwap_leg", "ranked_volume_leg"], "output": "sum_ranked_legs"},
    {"name": "Mul", "param": [], "input": ["sum_ranked_legs", "blend_weight"], "output": "additive_signal"},
    {"name": "Rank", "param": ["lookback_period"], "input": ["additive_signal"], "output": "alpha"}
  ],
  "arguments": [
    {"lookback_period": 20, "short_window": 1, "long_window": 60},
    {"lookback_period": 40, "short_window": 1, "long_window": 90},
    {"lookback_period": 60, "short_window": 1, "long_window": 120}
  ]
}
