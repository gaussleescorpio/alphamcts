{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "vwap_gap"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["vwap_gap", "vwap"],
      "output": "vwap_deviation"
    },
    {
      "name": "Zscore",
      "param": ["short_lookback"],
      "input": ["vwap_deviation"],
      "output": "zscore_short"
    },
    {
      "name": "Zscore",
      "param": ["long_lookback"],
      "input": ["vwap_deviation"],
      "output": "zscore_long"
    },
    {
      "name": "Neg",
      "param": [],
      "input": ["zscore_short"],
      "output": "neg_zscore_short"
    },
    {
      "name": "Neg",
      "param": [],
      "input": ["zscore_long"],
      "output": "neg_zscore_long"
    },
    {
      "name": "Rank",
      "param": ["short_lookback"],
      "input": ["neg_zscore_short"],
      "output": "vwap_rank_short"
    },
    {
      "name": "Rank",
      "param": ["long_lookback"],
      "input": ["neg_zscore_long"],
      "output": "vwap_rank_long"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["vwap_rank_short", "vwap_rank_long"],
      "output": "vwap_rank_diff"
    },
    {
      "name": "Greater",
      "param": [],
      "input": ["vwap_rank_short", "vwap_rank_long"],
      "output": "vwap_rank_short_greater"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["vwap_rank_diff", "vwap_rank_short_greater"],
      "output": "vwap_rank_excess"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["vwap_rank_short", "vwap_rank_excess"],
      "output": "vwap_oversold"
    },
    {
      "name": "Min",
      "param": ["short_lookback"],
      "input": ["low"],
      "output": "min_low_short"
    },
    {
      "name": "Max",
      "param": ["short_lookback"],
      "input": ["high"],
      "output": "max_high_short"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["max_high_short", "min_low_short"],
      "output": "range_short"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "min_low_short"],
      "output": "close_above_low_short"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_above_low_short", "range_short"],
      "output": "range_pos_short"
    },
    {
      "name": "Min",
      "param": ["long_lookback"],
      "input": ["low"],
      "output": "min_low_long"
    },
    {
      "name": "Max",
      "param": ["long_lookback"],
      "input": ["high"],
      "output": "max_high_long"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["max_high_long", "min_low_long"],
      "output": "range_long"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "min_low_long"],
      "output": "close_above_low_long"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_above_low_long", "range_long"],
      "output": "range_pos_long"
    },
    {
      "name": "Max",
      "param": ["short_lookback"],
      "input": ["range_pos_short"],
      "output": "range_pos_short_peak"
    },
    {
      "name": "Max",
      "param": ["long_lookback"],
      "input": ["range_pos_long"],
      "output": "range_pos_long_peak"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["range_pos_short_peak", "range_pos_short"],
      "output": "range_drop_short"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["range_pos_long_peak", "range_pos_long"],
      "output": "range_drop_long"
    },
    {
      "name": "Rank",
      "param": ["short_lookback"],
      "input": ["range_drop_short"],
      "output": "range_rank_short"
    },
    {
      "name": "Rank",
      "param": ["long_lookback"],
      "input": ["range_drop_long"],
      "output": "range_rank_long"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["range_rank_short", "range_rank_long"],
      "output": "range_rank_diff"
    },
    {
      "name": "Greater",
      "param": [],
      "input": ["range_rank_short", "range_rank_long"],
      "output": "range_rank_short_greater"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["range_rank_diff", "range_rank_short_greater"],
      "output": "range_rank_excess"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["range_rank_short", "range_rank_excess"],
      "output": "range_oversold"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["vwap_oversold", "range_oversold"],
      "output": "oversold_core"
    },
    {
      "name": "Rank",
      "param": ["long_lookback"],
      "input": ["oversold_core"],
      "output": "oversold_ranked"
    },
    {
      "name": "Ma",
      "param": ["long_lookback"],
      "input": ["volume"],
      "output": "volume_baseline"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["volume", "volume_baseline"],
      "output": "relative_volume"
    },
    {
      "name": "Rank",
      "param": ["long_lookback"],
      "input": ["relative_volume"],
      "output": "volume_rank"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["oversold_ranked", "volume_rank"],
      "output": "combined_signal"
    },
    {
      "name": "Ma",
      "param": ["smoothing_window"],
      "input": ["combined_signal"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "short_lookback": 10,
      "long_lookback": 60,
      "smoothing_window": 10
    },
    {
      "short_lookback": 15,
      "long_lookback": 40,
      "smoothing_window": 5
    },
    {
      "short_lookback": 20,
      "long_lookback": 80,
      "smoothing_window": 15
    }
  ]
}
