{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["high", "low"],
      "output": "intraday_range"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["intraday_range", "vwap"],
      "output": "normalized_range"
    },
    {
      "name": "Ma",
      "param": ["range_window"],
      "input": ["normalized_range"],
      "output": "short_smoothed_range"
    },
    {
      "name": "Ma",
      "param": ["rank_lookback"],
      "input": ["normalized_range"],
      "output": "long_smoothed_range"
    },
    {
      "name": "Rank",
      "param": ["rank_lookback"],
      "input": ["short_smoothed_range"],
      "output": "short_range_rank"
    },
    {
      "name": "Rank",
      "param": ["rank_lookback"],
      "input": ["long_smoothed_range"],
      "output": "long_range_rank"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["short_range_rank", "long_range_rank"],
      "output": "relative_range_residual"
    },
    {
      "name": "Pct",
      "param": ["range_window"],
      "input": ["vwap"],
      "output": "vwap_pct"
    },
    {
      "name": "Sign",
      "param": [],
      "input": ["vwap_pct"],
      "output": "vwap_direction"
    },
    {
      "name": "Diff",
      "param": ["range_window"],
      "input": ["short_smoothed_range"],
      "output": "range_change"
    },
    {
      "name": "Ma",
      "param": ["range_window"],
      "input": ["volume"],
      "output": "smoothed_volume"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["smoothed_volume", "smoothed_volume"],
      "output": "unity_constant"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["smoothed_volume", "unity_constant"],
      "output": "volume_plus_one"
    },
    {
      "name": "Log",
      "param": [],
      "input": ["volume_plus_one"],
      "output": "log_smoothed_volume"
    },
    {
      "name": "Diff",
      "param": ["range_window"],
      "input": ["log_smoothed_volume"],
      "output": "volume_log_change"
    },
    {
      "name": "Abs",
      "param": [],
      "input": ["volume_log_change"],
      "output": "abs_volume_log_change"
    },
    {
      "name": "Ma",
      "param": ["rank_lookback"],
      "input": ["abs_volume_log_change"],
      "output": "ma_abs_volume_log_change"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["abs_volume_log_change", "ma_abs_volume_log_change"],
      "output": "elasticity_denominator"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["range_change", "elasticity_denominator"],
      "output": "raw_elasticity"
    },
    {
      "name": "Ma",
      "param": ["rank_lookback"],
      "input": ["raw_elasticity"],
      "output": "range_volume_elasticity"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["relative_range_residual", "vwap_direction"],
      "output": "partial_combined_signal"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["partial_combined_signal", "range_volume_elasticity"],
      "output": "combined_signal"
    },
    {
      "name": "Rank",
      "param": ["rank_lookback"],
      "input": ["combined_signal"],
      "output": "ranked_signal"
    },
    {
      "name": "Ma",
      "param": ["output_smoothing"],
      "input": ["ranked_signal"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "range_window": 5,
      "rank_lookback": 20,
      "output_smoothing": 5
    },
    {
      "range_window": 10,
      "rank_lookback": 40,
      "output_smoothing": 10
    },
    {
      "range_window": 8,
      "rank_lookback": 60,
      "output_smoothing": 5
    }
  ]
}
