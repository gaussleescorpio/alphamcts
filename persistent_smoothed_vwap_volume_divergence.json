{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "close_minus_vwap"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close_minus_vwap", "close"],
      "output": "price_vwap_displacement"
    },
    {
      "name": "Ma",
      "param": ["input_smooth_window"],
      "input": ["price_vwap_displacement"],
      "output": "smoothed_displacement"
    },
    {
      "name": "Ma",
      "param": ["input_smooth_window"],
      "input": ["volume"],
      "output": "smoothed_volume"
    },
    {
      "name": "Rank",
      "param": ["rank_window"],
      "input": ["smoothed_displacement"],
      "output": "ranked_displacement"
    },
    {
      "name": "Rank",
      "param": ["rank_window"],
      "input": ["smoothed_volume"],
      "output": "ranked_volume"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["ranked_displacement", "ranked_volume"],
      "output": "rank_spread"
    },
    {
      "name": "Ma",
      "param": ["fast_smooth_window"],
      "input": ["rank_spread"],
      "output": "fast_signal"
    },
    {
      "name": "Abs",
      "param": [],
      "input": ["fast_signal"],
      "output": "abs_fast_signal"
    },
    {
      "name": "Med",
      "param": ["rank_window"],
      "input": ["abs_fast_signal"],
      "output": "signal_threshold"
    },
    {
      "name": "Greater",
      "param": [],
      "input": ["abs_fast_signal", "signal_threshold"],
      "output": "is_strong_signal"
    },
    {
      "name": "Less",
      "param": [],
      "input": ["abs_fast_signal", "signal_threshold"],
      "output": "is_weak_signal"
    },
    {
      "name": "Diff",
      "param": [],
      "input": ["fast_signal"],
      "output": "fast_signal_diff"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["fast_signal", "fast_signal_diff"],
      "output": "delayed_fast_signal"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["is_strong_signal", "fast_signal"],
      "output": "strong_signal_component"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["is_weak_signal", "delayed_fast_signal"],
      "output": "weak_signal_component"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["strong_signal_component", "weak_signal_component"],
      "output": "gated_fast_signal"
    },
    {
      "name": "Ma",
      "param": ["rank_window"],
      "input": ["rank_spread"],
      "output": "slow_signal"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["slow_signal", "slow_signal"],
      "output": "doubled_slow_signal"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["slow_signal", "doubled_slow_signal"],
      "output": "triple_slow_signal"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["gated_fast_signal", "triple_slow_signal"],
      "output": "blend_numerator"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["close", "close"],
      "output": "unit_scalar"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["unit_scalar", "unit_scalar"],
      "output": "two_units"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["two_units", "two_units"],
      "output": "four_units"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["blend_numerator", "four_units"],
      "output": "blended_signal"
    },
    {
      "name": "Zscore",
      "param": ["rank_window"],
      "input": ["blended_signal"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "input_smooth_window": 10,
      "rank_window": 60,
      "fast_smooth_window": 5
    },
    {
      "input_smooth_window": 15,
      "rank_window": 40,
      "fast_smooth_window": 8
    },
    {
      "input_smooth_window": 20,
      "rank_window": 80,
      "fast_smooth_window": 10
    }
  ]
}
