{
  "name": "volume_weighted_intraday_efficiency_spread",
  "description": "Compares short-horizon trend efficiency against long-horizon session-aware trend efficiency.",
  "formula": [
    {"name": "Delay", "param": ["prior_close_lag"], "input": ["close"], "output": "prior_close"},
    {"name": "Div", "param": [], "input": ["close", "prior_close"], "output": "close_prior_ratio"},
    {"name": "Log", "param": [], "input": ["close_prior_ratio"], "output": "daily_log_return"},
    {"name": "Ma", "param": ["short_window"], "input": ["volume"], "output": "average_volume"},
    {"name": "Div", "param": [], "input": ["volume", "average_volume"], "output": "relative_volume"},
    {"name": "Add", "param": [], "input": ["volume", "average_volume"], "output": "volume_plus_average"},
    {"name": "Div", "param": [], "input": ["volume_plus_average", "average_volume"], "output": "volume_weight_ratio"},
    {"name": "Log", "param": [], "input": ["volume_weight_ratio"], "output": "volume_weight"},
    {"name": "Abs", "param": [], "input": ["daily_log_return"], "output": "abs_daily_log_return"},
    {"name": "Mul", "param": [], "input": ["abs_daily_log_return", "volume_weight"], "output": "weighted_daily_move"},
    {"name": "Delay", "param": ["short_window"], "input": ["close"], "output": "short_window_close"},
    {"name": "Div", "param": [], "input": ["close", "short_window_close"], "output": "short_close_ratio"},
    {"name": "Log", "param": [], "input": ["short_close_ratio"], "output": "short_log_return"},
    {"name": "Abs", "param": [], "input": ["short_log_return"], "output": "short_net_move"},
    {"name": "Sum", "param": ["short_window"], "input": ["weighted_daily_move"], "output": "short_volume_path"},
    {"name": "Div", "param": [], "input": ["short_net_move", "short_volume_path"], "output": "short_efficiency"},
    {"name": "Rank", "param": ["short_window"], "input": ["short_efficiency"], "output": "short_efficiency_rank"},
    {"name": "Delay", "param": ["long_window"], "input": ["close"], "output": "long_window_close"},
    {"name": "Div", "param": [], "input": ["close", "long_window_close"], "output": "long_close_ratio"},
    {"name": "Log", "param": [], "input": ["long_close_ratio"], "output": "long_log_return"},
    {"name": "Abs", "param": [], "input": ["long_log_return"], "output": "long_net_move"},
    {"name": "Div", "param": [], "input": ["close", "open"], "output": "close_open_ratio"},
    {"name": "Log", "param": [], "input": ["close_open_ratio"], "output": "intraday_log_return"},
    {"name": "Abs", "param": [], "input": ["intraday_log_return"], "output": "intraday_leg"},
    {"name": "Div", "param": [], "input": ["open", "prior_close"], "output": "open_prior_ratio"},
    {"name": "Log", "param": [], "input": ["open_prior_ratio"], "output": "overnight_log_return"},
    {"name": "Abs", "param": [], "input": ["overnight_log_return"], "output": "overnight_leg"},
    {"name": "Sum", "param": ["long_window"], "input": ["intraday_leg"], "output": "intraday_path"},
    {"name": "Sum", "param": ["long_window"], "input": ["overnight_leg"], "output": "overnight_path"},
    {"name": "Add", "param": [], "input": ["intraday_path", "overnight_path"], "output": "long_session_path"},
    {"name": "Div", "param": [], "input": ["long_net_move", "long_session_path"], "output": "long_efficiency"},
    {"name": "Rank", "param": ["long_window"], "input": ["long_efficiency"], "output": "long_efficiency_rank"},
    {"name": "Sub", "param": [], "input": ["short_efficiency_rank", "long_efficiency_rank"], "output": "efficiency_term_spread"},
    {"name": "Rank", "param": ["long_window"], "input": ["efficiency_term_spread"], "output": "alpha"}
  ],
  "arguments": [
    {"prior_close_lag": 1, "short_window": 10, "long_window": 60},
    {"prior_close_lag": 1, "short_window": 5, "long_window": 40},
    {"prior_close_lag": 1, "short_window": 15, "long_window": 90}
  ]
}
