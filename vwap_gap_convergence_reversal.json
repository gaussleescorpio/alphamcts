{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "price_vwap_gap_numerator"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["price_vwap_gap_numerator", "close"],
      "output": "price_vwap_gap"
    },
    {
      "name": "Ma",
      "param": ["short_window"],
      "input": ["price_vwap_gap"],
      "output": "gap_short_ma"
    },
    {
      "name": "Ma",
      "param": ["long_window"],
      "input": ["price_vwap_gap"],
      "output": "gap_long_ma"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["gap_short_ma", "gap_long_ma"],
      "output": "gap_convergence"
    },
    {
      "name": "Pct",
      "param": ["long_window"],
      "input": ["close"],
      "output": "close_return"
    },
    {
      "name": "Std",
      "param": ["short_window"],
      "input": ["close_return"],
      "output": "return_volatility"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["gap_convergence", "return_volatility"],
      "output": "volatility_adjusted_convergence"
    },
    {
      "name": "Med",
      "param": ["long_window"],
      "input": ["volume"],
      "output": "volume_median"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["volume", "volume_median"],
      "output": "volume_participation"
    },
    {
      "name": "Tanh",
      "param": [],
      "input": ["volume_participation"],
      "output": "volume_weight"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["volume_median", "volume_median"],
      "output": "double_volume_median"
    },
    {
      "name": "Less",
      "param": [],
      "input": ["volume", "double_volume_median"],
      "output": "normal_volume_day"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["volatility_adjusted_convergence", "volume_weight"],
      "output": "volume_adjusted_signal"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["volume_adjusted_signal", "normal_volume_day"],
      "output": "filtered_signal"
    },
    {
      "name": "Rank",
      "param": ["long_window"],
      "input": ["filtered_signal"],
      "output": "ranked_signal"
    },
    {
      "name": "Ma",
      "param": ["rank_smooth_window"],
      "input": ["ranked_signal"],
      "output": "smoothed_rank"
    },
    {
      "name": "Neg",
      "param": [],
      "input": ["smoothed_rank"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "short_window": 5,
      "long_window": 20,
      "rank_smooth_window": 5
    },
    {
      "short_window": 10,
      "long_window": 60,
      "rank_smooth_window": 10
    },
    {
      "short_window": 20,
      "long_window": 120,
      "rank_smooth_window": 15
    }
  ]
}
