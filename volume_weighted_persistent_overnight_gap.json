{
  "formula": [
    {
      "name": "Delay",
      "param": ["gap_lag_period"],
      "input": ["close"],
      "output": "prev_close"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["open", "prev_close"],
      "output": "gap_numerator"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["gap_numerator", "prev_close"],
      "output": "overnight_gap"
    },
    {
      "name": "Std",
      "param": ["lookback_period"],
      "input": ["overnight_gap"],
      "output": "gap_volatility"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["overnight_gap", "gap_volatility"],
      "output": "normalized_gap"
    },
    {
      "name": "Ma",
      "param": ["smoothing_window"],
      "input": ["normalized_gap"],
      "output": "smoothed_gap"
    },
    {
      "name": "Ma",
      "param": ["lookback_period"],
      "input": ["volume"],
      "output": "volume_mean"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["volume", "volume_mean"],
      "output": "raw_volume_ratio"
    },
    {
      "name": "Sub",
      "param": ["volume_cap"],
      "input": ["raw_volume_ratio"],
      "output": "excess_volume"
    },
    {
      "name": "Greater",
      "param": ["volume_cap"],
      "input": ["raw_volume_ratio"],
      "output": "is_capped"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["is_capped", "excess_volume"],
      "output": "cap_adjustment"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["raw_volume_ratio", "cap_adjustment"],
      "output": "capped_volume_ratio"
    },
    {
      "name": "Div",
      "param": ["volume_cap"],
      "input": ["capped_volume_ratio"],
      "output": "volume_weight"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["smoothed_gap", "volume_weight"],
      "output": "volume_weighted_persistent_overnight_gap"
    }
  ],
  "arguments": [
    {
      "gap_lag_period": 1,
      "lookback_period": 20,
      "smoothing_window": 5,
      "volume_cap": 2.0
    },
    {
      "gap_lag_period": 1,
      "lookback_period": 40,
      "smoothing_window": 10,
      "volume_cap": 2.5
    },
    {
      "gap_lag_period": 1,
      "lookback_period": 60,
      "smoothing_window": 3,
      "volume_cap": 3.0
    }
  ]
}
