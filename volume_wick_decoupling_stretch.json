{
  "formula": [
    {
      "name": "Log",
      "param": [],
      "input": ["volume"],
      "output": "log_volume"
    },
    {
      "name": "Diff",
      "param": ["diff_window"],
      "input": ["log_volume"],
      "output": "volume_change"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "open"],
      "output": "body_size"
    },
    {
      "name": "Abs",
      "param": [],
      "input": ["body_size"],
      "output": "abs_body"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["high", "low"],
      "output": "range_size"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["range_size", "abs_body"],
      "output": "wick_size"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["wick_size", "close"],
      "output": "wick_ratio"
    },
    {
      "name": "Diff",
      "param": ["diff_window"],
      "input": ["wick_ratio"],
      "output": "wick_change"
    },
    {
      "name": "Corr",
      "param": ["short_window"],
      "input": ["volume_change", "wick_change"],
      "output": "short_volume_wick_corr"
    },
    {
      "name": "Corr",
      "param": ["long_window"],
      "input": ["volume_change", "wick_change"],
      "output": "long_volume_wick_corr"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["short_volume_wick_corr", "long_volume_wick_corr"],
      "output": "corr_breakdown"
    },
    {
      "name": "Diff",
      "param": ["diff_window"],
      "input": ["close"],
      "output": "close_short_change"
    },
    {
      "name": "Diff",
      "param": ["long_window"],
      "input": ["close"],
      "output": "close_long_change"
    },
    {
      "name": "Sign",
      "param": [],
      "input": ["close_long_change"],
      "output": "medium_trend_sign"
    },
    {
      "name": "Rank",
      "param": ["short_window"],
      "input": ["close_short_change"],
      "output": "short_impulse_rank"
    },
    {
      "name": "Med",
      "param": ["short_window"],
      "input": ["short_impulse_rank"],
      "output": "rank_center"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["short_impulse_rank", "rank_center"],
      "output": "centered_short_impulse"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["medium_trend_sign", "centered_short_impulse"],
      "output": "stretch_filter"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["corr_breakdown", "stretch_filter"],
      "output": "raw_decoupling_signal"
    },
    {
      "name": "Std",
      "param": ["short_window"],
      "input": ["volume_change"],
      "output": "volume_shock_scale"
    },
    {
      "name": "Std",
      "param": ["short_window"],
      "input": ["wick_change"],
      "output": "wick_shock_scale"
    },
    {
      "name": "Add",
      "param": [],
      "input": ["volume_shock_scale", "wick_shock_scale"],
      "output": "combined_shock_scale"
    },
    {
      "name": "Ma",
      "param": ["short_window"],
      "input": ["combined_shock_scale"],
      "output": "mean_shock_scale"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["raw_decoupling_signal", "mean_shock_scale"],
      "output": "scaled_decoupling_signal"
    },
    {
      "name": "Ma",
      "param": ["short_window"],
      "input": ["scaled_decoupling_signal"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "diff_window": 5,
      "short_window": 20,
      "long_window": 60
    },
    {
      "diff_window": 2,
      "short_window": 10,
      "long_window": 40
    },
    {
      "diff_window": 10,
      "short_window": 30,
      "long_window": 90
    }
  ]
}
