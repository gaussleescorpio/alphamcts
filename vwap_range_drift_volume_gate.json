{
  "formula": [
    {
      "name": "Sub",
      "param": [],
      "input": ["high", "low"],
      "output": "intraday_range"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["close", "vwap"],
      "output": "vwap_dislocation"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["vwap_dislocation", "intraday_range"],
      "output": "closing_location"
    },
    {
      "name": "Ma",
      "param": ["drift_window"],
      "input": ["closing_location"],
      "output": "smoothed_closing_location"
    },
    {
      "name": "Delay",
      "param": ["drift_window"],
      "input": ["smoothed_closing_location"],
      "output": "lagged_smoothed_location"
    },
    {
      "name": "Sub",
      "param": [],
      "input": ["smoothed_closing_location", "lagged_smoothed_location"],
      "output": "location_drift"
    },
    {
      "name": "Ma",
      "param": ["baseline_window"],
      "input": ["volume"],
      "output": "volume_baseline"
    },
    {
      "name": "Div",
      "param": [],
      "input": ["volume", "volume_baseline"],
      "output": "relative_volume"
    },
    {
      "name": "Rank",
      "param": ["baseline_window"],
      "input": ["relative_volume"],
      "output": "participation_rank"
    },
    {
      "name": "Mul",
      "param": [],
      "input": ["location_drift", "participation_rank"],
      "output": "drift_with_participation"
    },
    {
      "name": "Ma",
      "param": ["smooth_window"],
      "input": ["drift_with_participation"],
      "output": "smoothed_signal"
    },
    {
      "name": "Rank",
      "param": ["baseline_window"],
      "input": ["smoothed_signal"],
      "output": "alpha"
    }
  ],
  "arguments": [
    {
      "drift_window": 10,
      "baseline_window": 20,
      "smooth_window": 5
    },
    {
      "drift_window": 15,
      "baseline_window": 40,
      "smooth_window": 10
    },
    {
      "drift_window": 20,
      "baseline_window": 60,
      "smooth_window": 5
    }
  ]
}
