    {"name": "Log", "param": [], "input": ["close"], "output": "log_close"},
    {"name": "Diff", "param": ["correlation_short_window"], "input": ["log_close"], "output": "log_close_change"},
    {"name": "Ma", "param": ["drift_window"], "input": ["log_close_change"], "output": "avg_drift"},
