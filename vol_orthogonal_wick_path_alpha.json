    {"name": "Ma", "param": ["rank_window"], "input": ["range_ratio_peak"], "output": "range_ratio_cap"},
    {"name": "Greater", "param": [], "input": ["range_ts_ratio", "range_ratio_med"], "output": "range_above_med"},
