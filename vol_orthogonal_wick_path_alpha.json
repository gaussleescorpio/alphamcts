    {"name": "Greater", "param": [], "input": ["wing_sign_prod", "wing_sign_neg"], "output": "wing_agreement_gate"},
    {"name": "Sign", "param": [], "input": ["open_smooth"], "output": "open_sign"},
    {"name": "Mul", "param": [], "input": ["clv_sign", "open_sign"], "output": "open_sign_prod"},
    {"name": "Abs", "param": [], "input": ["open_sign_prod"], "output": "open_sign_abs"},
    {"name": "Neg", "param": [], "input": ["open_sign_abs"], "output": "open_sign_neg"},
