    {"name": "Ma", "param": ["slow_window"], "input": ["clv_raw"], "output": "clv_slow_smooth"},
    {"name": "Rank", "param": ["rank_window"], "input": ["clv_smooth"], "output": "rank_clv_smooth"},
    {"name": "Ma", "param": ["slow_window"], "input": ["rank_clv_smooth"], "output": "clv_slow_rank_ma"},
    {"name": "Sub", "param": [], "input": ["rank_clv_smooth", "clv_slow_rank_ma"], "output": "clv_momentum"},
    {"name": "Div", "param": [], "input": ["range_hl", "close"], "output": "range_vol_proxy"},
    {"name": "Ma", "param": ["slow_window"], "input": ["range_vol_proxy"], "output": "range_vol_smooth"},
    {"name": "Rank", "param": ["rank_window"], "input": ["range_vol_smooth"], "output": "vol_sleeve_rank"},
