    {"name": "Mul", "param": [], "input": ["reg_slope", "vol_sleeve_rank"], "output": "vol_projection"},
    {"name": "Sub", "param": [], "input": ["clv_momentum", "vol_projection"], "output": "clv_residual"},
    {"name": "Rank", "param": ["rank_window"], "input": ["clv_residual"], "output": "residual_rank"},
    {"name": "Ma", "param": ["short_window"], "input": ["upper_frac"], "output": "upper_smooth"},
    {"name": "Ma", "param": ["short_window"], "input": ["lower_frac"], "output": "lower_smooth"},
    {"name": "Sub", "param": [], "input": ["upper_smooth", "lower_smooth"], "output": "wing_skew"},
    {"name": "Sign", "param": [], "input": ["clv_smooth"], "output": "clv_sign"},
    {"name": "Sign", "param": [], "input": ["wing_skew"], "output": "wing_sign"},
    {"name": "Sign", "param": [], "input": ["clv_slow_smooth"], "output": "clv_slow_sign"},
