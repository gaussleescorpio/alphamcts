    {"name": "Greater", "param": [], "input": ["short_slow_sign_prod", "short_slow_sign_neg"], "output": "clv_persistence_gate"},
    {"name": "Mul", "param": [], "input": ["clv_sign", "wing_sign"], "output": "wing_sign_prod"},
