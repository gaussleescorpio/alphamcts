{
  "formula": [
    {"name": "Delay", "param": ["signal_window"], "input": ["close"], "output": "prior_close"},
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "daily_range"},
    {"name": "Div", "param": [], "input": ["daily_range", "open"], "output": "range_ratio"},
    {"name": "Med", "param": ["trend_window"], "input": ["range_ratio"], "output": "median_range_ratio"},
    {"name": "Greater", "param": [], "input": ["range_ratio", "median_range_ratio"], "output": "wide_range_flag"},
    {"name": "Sub", "param": [], "input": ["close", "low"], "output": "close_minus_low"},
    {"name": "Div", "param": [], "input": ["close_minus_low", "daily_range"], "output": "close_range_position"},
    {"name": "Sub", "param": [], "input": ["vwap", "low"], "output": "vwap_minus_low"},
    {"name": "Div", "param": [], "input": ["vwap_minus_low", "daily_range"], "output": "vwap_range_position"},
    {"name": "Sub", "param": [], "input": ["close_range_position", "vwap_range_position"], "output": "acceptance_gap"},
    {"name": "Greater", "param": [], "input": ["close", "prior_close"], "output": "uptick_flag"},
    {"name": "Less", "param": [], "input": ["close", "prior_close"], "output": "downtick_flag"},
    {"name": "Mul", "param": [], "input": ["volume", "uptick_flag"], "output": "uptick_volume"},
    {"name": "Mul", "param": [], "input": ["volume", "downtick_flag"], "output": "downtick_volume"},
    {"name": "Sum", "param": ["signal_window"], "input": ["uptick_volume"], "output": "uptick_volume_sum"},
    {"name": "Sum", "param": ["signal_window"], "input": ["downtick_volume"], "output": "downtick_volume_sum"},
    {"name": "Sub", "param": [], "input": ["uptick_volume_sum", "downtick_volume_sum"], "output": "net_uptick_flow"},
    {"name": "Sub", "param": [], "input": ["close", "close"], "output": "zero_baseline"},
    {"name": "Greater", "param": [], "input": ["net_uptick_flow", "zero_baseline"], "output": "buying_pressure_flag"},
    {"name": "Mul", "param": [], "input": ["wide_range_flag", "acceptance_gap"], "output": "gated_acceptance"},
    {"name": "Mul", "param": [], "input": ["gated_acceptance", "buying_pressure_flag"], "output": "flow_confirmed_acceptance"},
    {"name": "Ma", "param": ["signal_window"], "input": ["flow_confirmed_acceptance"], "output": "short_term_acceptance"},
    {"name": "Ma", "param": ["trend_window"], "input": ["flow_confirmed_acceptance"], "output": "long_term_acceptance"},
    {"name": "Sub", "param": [], "input": ["short_term_acceptance", "long_term_acceptance"], "output": "acceptance_momentum"},
    {"name": "Rank", "param": ["rank_window"], "input": ["acceptance_momentum"], "output": "alpha"}
  ],
  "arguments": [
    {"signal_window": 5, "trend_window": 20, "rank_window": 60},
    {"signal_window": 10, "trend_window": 40, "rank_window": 120},
    {"signal_window": 20, "trend_window": 60, "rank_window": 60}
  ]
}
