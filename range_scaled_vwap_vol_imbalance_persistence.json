    {"name": "Sub", "param": [], "input": ["up_volume_sum", "down_volume_sum"], "output": "volume_net_diff"},
    {"name": "Div", "param": [], "input": ["volume_net_diff", "total_volume_sum"], "output": "volume_imbalance"},
