{
  "formula": [
    {"name": "Sub", "param": [], "input": ["vwap", "vwap"], "output": "zero_level"},
    {"name": "Sub", "param": [], "input": ["close", "vwap"], "output": "price_vwap_gap"},
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "hl_diff"},
    {"name": "Abs", "param": [], "input": ["hl_diff"], "output": "bar_range"},
    {"name": "Ma", "param": ["signal_window"], "input": ["bar_range"], "output": "mean_bar_range"},
    {"name": "Div", "param": [], "input": ["price_vwap_gap", "mean_bar_range"], "output": "gap_normalized"},
    {"name": "Diff", "param": ["return_lag"], "input": ["close"], "output": "close_change"},
