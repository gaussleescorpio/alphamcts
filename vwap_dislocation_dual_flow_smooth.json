{
  "formula": [
    {"name": "Sub", "param": [], "input": ["close", "vwap"], "output": "vwap_dislocation"},
    {"name": "Abs", "param": [], "input": ["vwap_dislocation"], "output": "abs_vwap_dislocation"},
    {"name": "Ma", "param": ["norm_window"], "input": ["abs_vwap_dislocation"], "output": "dislocation_normalizer"},
    {"name": "Div", "param": [], "input": ["vwap_dislocation", "dislocation_normalizer"], "output": "normalized_vwap_dislocation"},
    {"name": "Ma", "param": ["flow_window"], "input": ["normalized_vwap_dislocation"], "output": "smoothed_vwap_dislocation"},
    {"name": "Corr", "param": ["flow_window"], "input": ["close", "volume"], "output": "short_horizon_price_volume_corr"},
    {"name": "Corr", "param": ["structural_window"], "input": ["close", "volume"], "output": "long_horizon_price_volume_corr"},
    {"name": "Ma", "param": ["flow_window"], "input": ["close"], "output": "close_ma_for_unit"},
    {"name": "Div", "param": [], "input": ["close_ma_for_unit", "close_ma_for_unit"], "output": "unit_scale"},
    {"name": "Sum", "param": ["structural_window"], "input": ["unit_scale"], "output": "structural_blend_weight"},
    {"name": "Sum", "param": ["flow_window"], "input": ["unit_scale"], "output": "flow_blend_weight"},
    {"name": "Mul", "param": [], "input": ["short_horizon_price_volume_corr", "structural_blend_weight"], "output": "weighted_short_corr"},
    {"name": "Mul", "param": [], "input": ["long_horizon_price_volume_corr", "flow_blend_weight"], "output": "weighted_long_corr"},
    {"name": "Add", "param": [], "input": ["weighted_short_corr", "weighted_long_corr"], "output": "sum_weighted_corr"},
    {"name": "Add", "param": [], "input": ["flow_blend_weight", "structural_blend_weight"], "output": "sum_blend_windows"},
    {"name": "Div", "param": [], "input": ["sum_weighted_corr", "sum_blend_windows"], "output": "blended_price_volume_corr"},
    {"name": "Abs", "param": [], "input": ["blended_price_volume_corr"], "output": "abs_blended_corr"},
    {"name": "Ma", "param": ["flow_window"], "input": ["abs_blended_corr"], "output": "corr_magnitude"},
    {"name": "Ma", "param": ["structural_window"], "input": ["abs_blended_corr"], "output": "corr_tanh_scale"},
    {"name": "Div", "param": [], "input": ["blended_price_volume_corr", "corr_tanh_scale"], "output": "corr_gate_input"},
    {"name": "Tanh", "param": [], "input": ["corr_gate_input"], "output": "continuous_corr_gate"},
    {"name": "Rank", "param": ["flow_window"], "input": ["volume"], "output": "relative_volume_rank"},
    {"name": "Mul", "param": [], "input": ["relative_volume_rank", "corr_magnitude"], "output": "rank_corr_product"},
    {"name": "Mul", "param": [], "input": ["rank_corr_product", "continuous_corr_gate"], "output": "volume_price_confirmation"},
    {"name": "Mul", "param": [], "input": ["smoothed_vwap_dislocation", "volume_price_confirmation"], "output": "combined_raw_signal"},
    {"name": "Ma", "param": ["composite_smooth_window"], "input": ["combined_raw_signal"], "output": "alpha"}
  ],
  "arguments": [
    {"norm_window": 20, "flow_window": 10, "structural_window": 40, "composite_smooth_window": 5},
    {"norm_window": 30, "flow_window": 15, "structural_window": 60, "composite_smooth_window": 8},
    {"norm_window": 40, "flow_window": 20, "structural_window": 80, "composite_smooth_window": 10}
  ]
}
