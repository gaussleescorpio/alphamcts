    {"name": "Rank", "param": ["rank_window"], "input": ["shadow_skew_ratio"], "output": "shadow_skew_rank"},
    {"name": "Ma", "param": ["smooth_window"], "input": ["shadow_skew_rank"], "output": "shadow_rank_smooth"},
    {"name": "Sub", "param": [], "input": ["shadow_rank_smooth", "shadow_skew_rank"], "output": "compression_signal"},
    {"name": "Div", "param": [], "input": ["day_range", "close"], "output": "normalized_range"},
