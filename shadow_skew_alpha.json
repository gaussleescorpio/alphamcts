{
  "formula": [
    {"name": "Sub", "param": [], "input": ["open", "close"], "output": "open_close_diff"},
    {"name": "Abs", "param": [], "input": ["open_close_diff"], "output": "open_close_abs_diff"},
    {"name": "Add", "param": [], "input": ["open", "close"], "output": "open_close_sum"},
    {"name": "Mul", "param": [], "input": ["close", "close"], "output": "close_squared"},
    {"name": "Inverse", "param": [], "input": ["close_squared"], "output": "inverse_close_squared"},
    {"name": "Mul", "param": [], "input": ["close", "inverse_close_squared"], "output": "unit_one"},
    {"name": "Add", "param": [], "input": ["unit_one", "unit_one"], "output": "unit_two"},
    {"name": "Add", "param": [], "input": ["open_close_sum", "open_close_abs_diff"], "output": "body_high_numerator"},
    {"name": "Div", "param": [], "input": ["body_high_numerator", "unit_two"], "output": "body_high"},
    {"name": "Sub", "param": [], "input": ["open_close_sum", "open_close_abs_diff"], "output": "body_low_numerator"},
    {"name": "Div", "param": [], "input": ["body_low_numerator", "unit_two"], "output": "body_low"},
    {"name": "Sub", "param": [], "input": ["high", "body_high"], "output": "upper_shadow"},
    {"name": "Sub", "param": [], "input": ["body_low", "low"], "output": "lower_shadow"},
    {"name": "Sub", "param": [], "input": ["upper_shadow", "lower_shadow"], "output": "shadow_diff"},
    {"name": "Abs", "param": [], "input": ["shadow_diff"], "output": "shadow_imbalance"},
    {"name": "Sub", "param": [], "input": ["high", "low"], "output": "day_range"},
