    {"name": "Corr", "param": ["corr_window"], "input": ["normalized_range", "lagged_normalized_range"], "output": "range_persistence"},
    {"name": "Neg", "param": [], "input": ["range_persistence"], "output": "decorrelation_score"},
    {"name": "Rank", "param": ["rank_window"], "input": ["decorrelation_score"], "output": "range_decorrelation_rank"},
    {"name": "Mul", "param": [], "input": ["compression_signal", "range_decorrelation_rank"], "output": "alpha"}
